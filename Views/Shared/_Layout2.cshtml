@{
    string url;
}
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="~/css/Layout1.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Modal.css" asp-append-version="true" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <link href="https://cdn.datatables.net/v/bs5/jq-3.7.0/dt-2.1.8/b-3.1.2/r-3.0.3/sb-1.8.1/sp-2.3.3/sl-2.1.0/datatables.min.css" rel="stylesheet">
    <script src="https://cdn.datatables.net/v/bs5/jq-3.7.0/dt-2.1.8/b-3.1.2/r-3.0.3/sb-1.8.1/sp-2.3.3/sl-2.1.0/datatables.min.js"></script>
    <script defer src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script defer src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script defer src="https://cdn.datatables.net/2.1.8/js/dataTables.js"></script>
    <script defer src="https://cdn.datatables.net/2.1.8/js/dataTables.bootstrap5.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta1/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta1/dist/js/bootstrap.bundle.min.js" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.2.1/jquery.min.js" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/boxicons@latest/css/boxicons.min.css" asp-append-version="true" />
    <link href="~/dist/css/adminlte.css" rel="stylesheet" />
    <link href="~/dist/css/adminlte.min.css" rel="stylesheet" />
    <link href="~/dist/css/adminlte.rtl.css" rel="stylesheet" />
    <link href="~/dist/css/adminlte.rtl.min.css" rel="stylesheet" />
    <script src="~/dist/js/adminlte.js"></script>
    <script src="~/dist/js/adminlte.min.js"></script>
<style>
    .notification{
        background-color:#f0f0f0;
        border:1px solid #ccc;
        padding: 10px;
        position:absolute;
        border-radius:5px;
        z-index:2;
    }
</style>
</head>
    <body id="body-pd">
        <header class="header" id="header">
        <div id="notifications"></div>
            <div class="header_toggle"> <i class='bx bx-menu' id="header-toggle"></i> </div>
        </header>
        <div class="l-navbar" id="nav-bar">
            <nav class="nav">
                <div>
                <a href="#" class="nav_logo" style="text-decoration:none;"> <i class='bx bx-home nav_logo-icon'></i> <span class="nav_logo-name" style="text-decoration:none; font-size:13px">C.S.H.A HOA System</span> </a>
                    <div class="nav_list">

                    @{ url = Url.Action("Dashboard", "UserMenu");}
                    <a class="nav_link @(Context.Request.Path == url ? "active" : null)" href="@url" > <i class='bx bx-grid-alt nav_icon'></i> <span class="nav_name">Dashboard</span></a>


                    @{url = Url.Action("AssociationDues", "UserMenu");}
                    <a  class="nav_link @(Context.Request.Path == url ? "active" : null)" href="@url"> <i class='bx bx-user nav_icon'></i> <span class="nav_name">Association Dues</span> </a>
                    
                    @{
                        url = Url.Action("Announcements", "UserMenu");
                    }
                    <a class="nav_link @(Context.Request.Path == url ? "active" : null)" href="@url"> <i class='bx bx-user nav_icon'></i> <span class="nav_name">Announcements</span> </a>

                    @{url = Url.Action("Logs", "UserMenu");}
                    <a class="nav_link @(Context.Request.Path == url ? "active" : null)" href="@url"> <i class='bx bx-message-square-detail nav_icon'></i> <span class="nav_name">Logs</span> </a>

                     @{url = Url.Action("VisitorsList", "UserMenu");}
                    <a class="nav_link @(Context.Request.Path == url ? "active" : null)" href="@url"> <i class='bx bx-user nav_icon'></i> <span class="nav_name">Visitors List</span> </a>
                    
                    @{url = Url.Action("VehiclesList", "UserMenu");}
                    <a class="nav_link @(Context.Request.Path == url ? "active" : null)" href="@url"> <i class='bx bx-car nav_icon'></i> <span class="nav_name">Vehicles List</span></a>
                    
                    @{url = Url.Action("HomeList", "UserMenu");}
                    <a class="nav_link @(Context.Request.Path == url ? "active" : null)" href="@url"> <i class='bx bx-building-house nav_icon'></i> <span class="nav_name">Home List</span></a>
                        <a  class="nav_link dropdown-toggle" data-bs-toggle="dropdown">
                            <i class='bx bx-user-circle nav_icon'></i><span class="nav_name">Profile</span>
                        </a>
                        <ul class="dropdown-menu" style="font-size:10px;">
                            <li>
                            @{
                                url = Url.Action("_ChangeUserPass", "UserMenu");
                            }
                            <a class="dropdown-item @(Context.Request.Path == url ? "active" : null)" href="@url">Change Account Username and Password</a>
                            </li>
                        <li><a class="dropdown-item" href="#">Edit Personal Details</a></li>
                        </ul>
                </div>
                </div> <a href="#" class="nav_link"> <i class='bx bx-log-out nav_icon'></i> <span class="nav_name">SignOut</span> </a>
            </nav>
        </div>
        <!--Container Main start-->
    <div class="height-100" style="margin-top:4rem">
        
            @RenderBody()
        </div>
        <!--Container Main end-->
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="~/js/notification.js"></script>
    <script src="~/js/Layout1.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
