@model Homeowner_details
<button id="RFIDnumber">click Me</button>
@{
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
    var isValue = false
    $("#RFIDnumber").on('click', function () {
        $(this).val("Listening...");
        Timer(5000);
        //do dome scanning on rfid
        $.post("@Url.Action("ReadRFID", "Rfid")",
            {
                userdata: ""
            },
            function (data) {
                if (data == 0) {
                    isValue = false;
                }
                else {
                    $("#RFIDnumber").val(data);
                    isValue = true;
                }
            });

    });
    async function Timer(time) {
        setTimeout(function () {
            if (isValue == false) {
                $("#RFIDnumber").val("N/A");
            }

        }, time);
    }
</script>