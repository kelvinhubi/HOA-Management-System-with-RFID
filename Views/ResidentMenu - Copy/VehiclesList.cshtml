@model IEnumerable<Vehicle_Information>
@{
    Layout = "~/Views/Shared/_Layout4.cshtml";
}
<head>
    <title>
        @{
            ViewData["Title"] = "My Vehicles";
        }
    </title>
</head>
<div id="UserPartial">
    <h2>My Vehicles</h2>
    <table id="mytable" class="table">
        <thead class="table-light">
            <tr>
                <th>Plate No.</th>
                <th>Vehicle Model</th>
                <th>Vehicle Type</th>
                <th>RFID No.</th>
                <th>RFID Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var obj in Model)
            {
                <tr>
                    @{
                        var rfid = obj.RFID_number != string.Empty ? obj.RFID_number : "N/A";
                    }
                    <td>@obj.PlateNo</td>
                    <td>@obj.VehicleModel</td>
                    <td>@obj.VehicleType</td>
                    <td>@obj.RFID_number</td>
                    <td>@obj.RFID_status</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<script>
    new DataTable('#mytable');
</script>