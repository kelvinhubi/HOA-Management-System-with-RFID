@model NewModel
@{
    Layout = "~/Views/Shared/_Layout1.cshtml";
    var myid = Convert.ToInt32(ViewData["SessionID"]);
}
<head>
    <title>
        @{
            ViewData["Title"] = "Events";
        }
    </title>
    <style>
        .modal {
        display: none; /* Hidden by default */
        position: fixed;
        z-index: 1;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0,0,0,0.4);
        }
        iframe{
        height:100%;
        }
        .modal-content {
        background-color: #fefefe;
        margin: 5% auto;
        padding: 20px;
        border: 1px solid #888;
        width: 80%;
        height:80%;
        }

        .close {
        position: absolute;
        top: 0;
        right: 25px;
        font-size: 35px;
        font-weight: bold;
        color: #000;
        cursor: pointer;
        }</style>
</head>
<div id="UserPartial">
    <h2>Event List</h2>
    <table id="mytable" class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>Event ID</th>
                <th>Event Title</th>
                <th>Fee Amount</th>
                <th>Event Date</th>
                <th>Registration Start Date</th>
                <th>Registration End Date</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var obj in Model.Events)
            {
                var obj2 = Model.EventsReserved.Where(_ => obj.EventID == _.EventID);
                if (obj.EventCapacity != obj2.Count()&&(obj.EventStartDate<DateTime.Now && obj.EventEndDate>DateTime.Now) )
                {
                    <tr>
                        <td>@obj.EventID</td>
                        <td>@obj.EventTitle</td>
                        @if (obj.EventFee != null)
                        {
                            <td>@obj.EventFee</td>
                            <td>@obj.EventDate</td>
                            <td>@obj.EventStartDate</td>
                            <td>@obj.EventEndDate</td>
                             <td>
                            @{
                                var result = obj2.FirstOrDefault(_ => _.AccountID == myid && _.EventID == obj.EventID);
                                if (result != null)
                                {
                                        <button type="button" class="btn-sm btn-success pay" disabled>Joined<i class='bx bxs-user-detail'></i></button>
                                }
                                else
                                {
                                    <button type="button" class="btn-sm btn-success pay">Join<i class='bx bxs-user-detail'></i></button>
                                }
                            }
                                <a asp-action="_EventDetails" class="btn btn-success btn-sm" asp-route-id="@obj.EventID" model="@Model">Details<i class='bx bxs-user-detail'></i></a>
                            </td>
                        }
                        else
                        {
                            <td>Free</td>
                            <td>@obj.EventDate</td>
                            <td>@obj.EventStartDate</td>
                            <td>@obj.EventEndDate</td>    
                            <td>
                            @{
                                var result = obj2.FirstOrDefault(_ => _.AccountID == myid && _.EventID == obj.EventID);
                                if (result != null)
                                {
                                        <button type="button" class="btn-sm btn-success " disabled>Joined<i class='bx bxs-user-detail'></i></button>
                                }
                                else
                                {
                                    <a asp-action="JoinFree" asp-route-EvID="@obj.EventID" type="button" class="btn-sm btn-success">Join<i class='bx bxs-user-detail'></i></a>
                                }
                             }
                                <a asp-action="_EventDetails" class="btn btn-success btn-sm" asp-route-id="@obj.EventID" model="@Model">Details<i class='bx bxs-user-detail'></i></a>
                            </td>
                        }
                    </tr>
                    
                }
            }
        </tbody>
    </table>
</div>
<div id="modal" class="modal">
    <div class="modal-content">
        <span class="close">&times;</span>
        <iframe id="frameload" src="" frameborder="0"></iframe>
    </div>
</div>
@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}
<script>
    new DataTable('#mytable');
    const modal = document.getElementById("modal");
    const btn = document.getElementById("open-modal");
    const span = document.getElementsByClassName("close")[0];
    const div = document.getElementById("UserPartial");
    var id_link = "";
    var EventID = "";
    span.onclick = function () {
            modal.style.display = "none";
            div.style.display = "block";
        $.post('@Url.Action("CheckPaymentForEvent", "UserMenu")', {
            id: id_link,
            EvID: EventID
        }, function (data) {
            if (data.success) {
                alert("Payment Succesfull");
                window.location.reload();
            }
            else {
                alert("Payment Cancelled");
                window.location.reload();
            }
        });
    }

    $(document).on('click','.pay', function () {
        EventID = $(this).closest("tr").find('td:eq(0)').text();
        var invoice = $(this).closest("tr").find('td:eq(1)').text();
        var amount = $(this).closest("tr").find('td:eq(2)').text();

        $.post('@Url.Action("Payout", "UserMenu")', {
            Amount: amount,
            Invoice: invoice
        }, 
        function (json) {
            if (json != null) {
                    modal.style.display = "block";
                    div.style.display = "none";
                id_link = json.data.id;
                $("#frameload").attr("src", json.data.attributes.checkout_url);
            }
                
        });
    });
</script>