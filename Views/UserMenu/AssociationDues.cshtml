@model NewModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
}
<head>
    <title>
        @{
            ViewData["Title"] = "Payment Dues";
        }
    </title>
    <style>
        .modal {
            display: none; /* Hidden by default */
            position: fixed;
            z-index: 1;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgba(0,0,0,0.4);
        }
        iframe{
            height:100%;
        }
        .modal-content {
            background-color: #fefefe;
            margin: 5% auto;
            padding: 20px;
            border: 1px solid #888;
            width: 80%;
            height:80%;
        }

        .close {
            position: absolute;
            top: 0;
            right: 25px;
            font-size: 35px;
            font-weight: bold;
            color: #000;
            cursor: pointer;
        }</style>
</head>
@Html.AntiForgeryToken()
<div id="UserPartial">
    <h2>My Dues</h2>
    <table id="mytable" class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>Type of Dues</th>
                <th>Name of Due</th>
                <th>Invoice No.</th>
                <th>Amount</th>
                <th>Due Date</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var obj in Model.ListDues)
            {
                <tr>
                    <td>@obj.TypeOfFee</td>
                    <td>@obj.FeesName</td>
                    <td>@obj.Invoice</td>
                    <td>@obj.Amount</td>
                    <td><div id="duedate">@obj.Date</div></td>
                    <td><div id="status">@obj.Status</div></td>
                    @{
                        if (obj.Status.Equals("Paid"))

                        {
                            <td>
                                <a class="btn-sm btn-success details">Details<i class='bx bxs-user-detail'></i></a>
                            </td>
                        }
                        else
                        {
                            <td>
                                <button type="button" class="btn-sm btn-success pay">Pay<i class='bx bxs-user-detail'></i></button>
                            </td>
                        }
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

<div id="modal" class="modal">
    <div class="modal-content">
        <span class="close">&times;</span>
        <iframe id="frameload" src="" frameborder="0"></iframe>
    </div>
</div>
@section Scripts {
    @{
                                                                            <partial name="_ValidationScriptsPartial" />
    }
}
<script>
    var table = new DataTable('#mytable');
    const modal = document.getElementById("modal");
    const btn = document.getElementById("open-modal");
    const span = document.getElementsByClassName("close")[0];
    const div = document.getElementById("UserPartial");
    var id_link = "";
    span.onclick = function () {
            modal.style.display = "none";
            div.style.display = "block";
        $.post('@Url.Action("CheckPayment", "UserMenu")', {
            id: id_link
        }, function (data) {
            if (data.success) {
                alert("Payment Succesfull");
                window.location.reload();
            }
            else {
                alert("Payment Cancelled");
                window.location.reload();
            }
        });
    }
    $(document).on('click','.pay', function () {
        var invoice = $(this).closest("tr").find('td:eq(2)').text();
        var amount = $(this).closest("tr").find('td:eq(3)').text();
        $.post('@Url.Action("Payout", "UserMenu")', {
            Amount: amount,
            Invoice: invoice
        }, 
        function (json) {
            if (json != null) {
                    modal.style.display = "block";
                    div.style.display = "none";
                id_link = json.data.id;
                $("#frameload").attr("src", json.data.attributes.checkout_url);
            }
                
        });
    });
    window.onload = function () {
        var table = document.querySelectorAll("#status");
        for (let i = 0; i < table.length; i++) {
            let col = table[i].innerHTML;
            if (col == "Unpaid") {
                table[i].classList.add('bx', 'bxs-user-x', 'card-danger', 'bg-danger')
                table[i].style.cssText = "width:100%; padding:15px;";
            }
            if (col == "Paid") {
                table[i].classList.add('bx', 'bxs-user-x', 'card-success', 'bg-success')
                table[i].style.cssText = "width:100%; padding:15px;";
            }
        }
            var table = document.querySelectorAll("#duedate");
            for (let i = 0; i < table.length; i++) {
                let col = table[i].innerHTML
                var due = new Date(col)
                var date = new Date()
                if (due.getDate() <= date.getDate() && due.getMonth <= date.getMonth && due.getFullYear() <= date.getFullYear()) {
                    table[i].classList.add('bx', 'bxs-error-alt', 'card-warning', 'bg-warning');
                    table[i].style.cssText = "width:100%; padding:15px;";
                }

            }
    }
    $(document).ready(function () {
        $(document, "dt-column-title").on('click change', function () {
            var table = document.querySelectorAll("td");
            for (let i = 0; i < table.length; i++) {
                let col = table[i].innerHTML;
                if (col == "Unpaid") {
                    table[i].classList.add('bx', 'bxs-user-x', 'card-danger', 'bg-danger')
                    table[i].style.cssText = "width:100%; padding:15px;";
                }
                if (col == "Paid") {
                    table[i].classList.add('bx', 'bxs-user-x', 'card-success', 'bg-success')
                    table[i].style.cssText = "width:100%; padding:15px;";
                }
            }
            var table = document.querySelectorAll("#duedate");
            for (let i = 0; i < table.length; i++) {
                let col = table[i].innerHTML
                var due = new Date(col)
                var date = new Date()
                if (due.getDate() <= date.getDate() && due.getMonth <= date.getMonth && due.getFullYear() <= date.getFullYear()) {
                    table[i].classList.add('bx', 'bxs-error-alt', 'card-warning', 'bg-warning');
                    table[i].style.cssText = "width:100%; padding:15px;";

                }

            }
        })
    });
</script>