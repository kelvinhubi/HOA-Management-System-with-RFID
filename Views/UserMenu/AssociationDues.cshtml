@model NewModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
}
<head>
    <title>
        @{
            ViewData["Title"] = "Payment Dues";
        }
    </title>
</head>
@Html.AntiForgeryToken();
<div id="UserPartial">
    <h2>Accounts</h2>
    <table id="mytable" class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>Type of Dues</th>
                <th>Name of Due</th>
                <th>Invoice No.</th>
                <th>Amount</th>
                <th>Due Date</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var obj in Model.ListDues)
            {
                <tr>
                    
                    <td>@obj.TypeofDues</td>
                    <td>@obj.FeesName</td>
                    <td>@obj.Invoice</td>
                    <td>@obj.Amount</td>
                    <td>@obj.Date</td>
                    <td>@obj.Status</td>
                    <td>
                        <button class="btn-sm btn-success">Pay<i class='bx bxs-user-detail'></i></button>
                    </td>

                </tr>
            }
        </tbody>
    </table>
</div>
@section Scripts {
    @{
                                <partial name="_ValidationScriptsPartial" />
    }
}
<script>
    new DataTable('#mytable');

    $(".btn-sm").on('click', function () {
        var invoice = $(this).closest("tr").find('td:eq(2)').text();
        var amount = $(this).closest("tr").find('td:eq(3)').text();
        console.log(amount);
        $.post('@Url.Action("Payout", "UserMenu")', {
            Amount: amount,
            Invoice: invoice
        }, 
        function (json) {
            if (json != null) {
                    window.location.replace(json.data.attributes.checkout_url)
            }
                
        });
    });
</script>