@model NewModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
}
<head>
    <title>
        @{
            ViewData["Title"] = "Payment Dues";
        }
    </title>
    <style>
        .modal {
            display: none; /* Hidden by default */
            position: fixed;
            z-index: 1;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgba(0,0,0,0.4);
        }
        iframe{
            height:100%;
        }
        .modal-content {
            background-color: #fefefe;
            margin: 5% auto;
            padding: 20px;
            border: 1px solid #888;
            width: 80%;
            height:80%;
        }

        .close {
            position: absolute;
            top: 0;
            right: 25px;
            font-size: 35px;
            font-weight: bold;
            color: #000;
            cursor: pointer;
        }</style>
</head>
@Html.AntiForgeryToken()
<div id="UserPartial">
    <h2>Accounts</h2>
    <table id="mytable" class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>Type of Dues</th>
                <th>Name of Due</th>
                <th>Invoice No.</th>
                <th>Amount</th>
                <th>Due Date</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var obj in Model.ListDues)
            {
                <tr>
                    
                    <td>@obj.TypeofDues</td>
                    <td>@obj.FeesName</td>
                    <td>@obj.Invoice</td>
                    <td>@obj.Amount</td>
                    <td>@obj.Date</td>
                    <td>@obj.Status</td>
                    <td>
                        <button class="btn-sm btn-success">Pay<i class='bx bxs-user-detail'></i></button>
                    </td>

                </tr>
            }
        </tbody>
    </table>
</div>

<div id="modal" class="modal">
    <div class="modal-content">
        <span class="close">&times;</span>
        <iframe id="frameload" src="" frameborder="0"></iframe>
    </div>
</div>
@section Scripts {
    @{
                                                                <partial name="_ValidationScriptsPartial" />
    }
}
<script>
    var table = new DataTable('#mytable');
    const modal = document.getElementById("modal");
    const btn = document.getElementById("open-modal");
    const span = document.getElementsByClassName("close")[0];
    const div = document.getElementById("UserPartial");
    var id_link = "";
    span.onclick = function () {
        modal.style.display = "none";
        div.style.display = "block";
        modal.style.display = "none";
        div.style.display = "block";
        $.post('@Url.Action("CheckPayment", "UserMenu")', {
            id: id_link
        }, function (data) {
            if (data.success) {
                alert("Payment Succesfull");
                window.location.reload();
            }
            else {
                alert("Payment Cancelled");
                window.location.reload();
            }
        });
    }
    $(document).on('click','.btn-sm', function () {
        var invoice = $(this).closest("tr").find('td:eq(2)').text();
        var amount = $(this).closest("tr").find('td:eq(3)').text();
        var value = table.row(12).data();

        console.log(value);
        $.post('@Url.Action("Payout", "UserMenu")', {
            Amount: amount,
            Invoice: invoice
        }, 
        function (json) {
            if (json != null) {
                    modal.style.display = "block";
                    div.style.display = "none";
                id_link = json.data.id;
                $("#frameload").attr("src", json.data.attributes.checkout_url);
            }
                
        });
    });
</script>