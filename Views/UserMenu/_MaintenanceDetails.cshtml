@model MaintenanceRequests
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
}
<head>
    <title>
        @{
            ViewData["Title"] = "Request Details";
        }
    </title>

</head>
<div class="card mb-4">
    <div class="card-header">Request Details</div>
    <div class="card-body">
        <form>
            <div class="mb-3">
                <label class="small mb-1" asp-for="RequestType">Request Type</label>
                <input asp-for="RequestType" class="form-control" type="text" readonly>
            </div>
            <div class="row gx-3 mb-3">
                <div class="col-md-6">
                    <label class="small mb-1" asp-for="RequestDexcription">Request Description</label>
                    <textarea asp-for="RequestDexcription" class="form-control" readonly></textarea>
                </div>
            </div>
            <div class="row gx-3 mb-3">
                <div class="col-md-6">
                    <label class="small mb-1" asp-for="RequestDate">Request Date</label>
                    <input asp-for="RequestDate" class="form-control" type="date" readonly>
                </div>
                <div class="col-md-6">
                    <label class="small mb-1" asp-for="RequestStatus">Status</label>
                    <input asp-for="RequestStatus" class="form-control" readonly>
                </div>
            </div>
            <div class="mb-3">
                <label class="small mb-1">Completion Date</label>
                <input class="form-control" value="CompletionDate.ToString(" MMM dd, yyyy hh:mm tt")" readonly>
            </div>
            <a asp-action="MaintenanceRequest" class="btn btn-primary">Back To List</a>
        </form>
    </div>
</div>