@model NewModel
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
}
<div id="UserPartial">
    <h2>Owned Homes</h2>
    <table id="mytable" class="table table-bordered" style="width:100%">
        <thead class="table-light">
            <tr>
                <th>Home Type</th>
                <th>Blk No</th>
                <th>Address</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var obj in Model.Homes)
            {
                <tr>
                    <td>@obj.HomeName</td>
                    <td>@obj.BlkNO</td>
                    <td>@obj.Address</td>
                </tr>
            }
        </tbody>
    </table>
    <h2>Requests</h2>
    <table id="mytable1" class="table table-bordered" style="width:100%">
        <thead class="table-light">
            <tr>
                <th>Resident Name</th>
                <th>Home Type</th>
                <td>Lot No</td>
                <th>Blk No</th>
                <th>Address</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
                @foreach (var obj in Model.HomeRequests)
                {
                    var resname = Model.Homeacc.Where(_ => _.AccountID == obj.ResidentID).Select(k => k.FullName).FirstOrDefault();
                    <tr>
                    <td>@resname</td>
                    <td>@obj.HomeName</td>
                    <td>@obj.LotNo</td>
                    <td>@obj.BlkNO</td>
                    <td>@obj.Address</td>
                    <td>@obj.Status</td>
                    @{
                        if (obj.Status.Equals("Approved") || obj.Status.Equals("Rejected"))
                        {
                           <td></td>
                        } 
                        else
                        {
                            <td>
                                <a asp-action="_AcceptRequest" class="btn btn-primary btn-sm" asp-route-id="@obj.HomeReqID">Accept<i class='bx bxs-user-detail'></i></a>
                                <a asp-action="_RejectRequest" class="btn btn-danger btn-sm" asp-route-id="@obj.HomeReqID">Reject<i class='bx bxs-user-detail'></i></a>
                            </td>
                        }
                    }
                </tr>
                }
        </tbody>
    </table>
</div>
<script>
    new DataTable('#mytable');
    new DataTable('#mytable1');
</script>