@model IEnumerable<HomesList>
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
}
<div id="UserPartial">
    <h2>Homes List</h2>
    <table id="mytable" class="table table-bordered" style="width:100%">
        <thead class="table-light">
            <tr>
                <th>Home ID</th>
                <th>Home Type</th>
                <th>Blk No</th>
                <th>Address</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var obj in Model)
            {
                <tr>
                    <td>@obj.HomeID</td>
                    <td>@obj.HomeName</td>
                    <td>@obj.BlkNO</td>
                    <td>@obj.Address</td>
                </tr>
            }
        </tbody>
    </table>
</div>