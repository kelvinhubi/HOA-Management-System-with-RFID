@model NewModel
@{
    Layout = "~/Views/Shared/_Layout3.cshtml";

}
<head>
    <title>
        @{
            ViewData["Title"] = "User Management";
        }
    </title>
</head>
@Html.AntiForgeryToken();
<div id="UserPartial">
    <h2>Entry and Exit Logs</h2>
    <table id="mytable" class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>Log ID</th>
                <th>Guard ID</th>
                <th>Time</th>
                <th>Log Type</th>
                <th>RFID No.</th>
                <th>Plate No.</th>
                <th>Full Name</th>
            </tr>
        </thead>
    </table>
</div>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
<script>
    window.onload = function(){
        Timer();
    }
    async function Timer() { 
        setInterval(function () {
            console.log("PR");
            $.get('@Url.Action("getCount", "GuardMenu")', function (data) {
                if (updatedvalue < data) {
                    populate();
                }
            });
        }, 1000);
    }
    let updatedvalue = 0;
   async function populate() { 
        if ($.fn.DataTable.isDataTable('#mytable')) {
            $('#mytable').DataTable().destroy();
        }
        $('#mytable tbody').empty();
        $.get('@Url.Action("GetEntryLogs","GuardMenu")', 
        function (data1) {
            console.log(data1);
            updatedvalue = data1.length;
            var table = $('#mytable').DataTable({
                    data: data1,
                    columns: [{data: 'logID'}, { data: 'guardID' }, { data: 'time' }, { data: 'logType' }, { data: 'rfiD_number' }, { data: 'plateNo' }, { data: 'fullName' }]
            });
        });
    }
    var connection2 = new signalR.HubConnectionBuilder().withUrl("/chat").build();
    connection2.start().catch(function (err) {
    return console.error(err.toString());
});
    connection2.on("GetGuardLog", function (Message) {
    const notification = document.getElementById('notifications');
    notification.classList.remove('notification');
    notification.textContent = "";
    notification.classList.add('notification');
    notification.textContent = Message;
    console.log(Message);
    setTimeout(() => {
        notification.classList.remove('notification');
        notification.textContent = "";
    }, 5000);
});
</script>