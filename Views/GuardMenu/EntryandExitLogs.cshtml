
@{
    Layout = "~/Views/Shared/_Layout3.cshtml";

}
<head>
    <title>
        @{
            ViewData["Title"] = "User Management";
        }
    </title>
</head>
@Html.AntiForgeryToken();
<div id="UserPartial">
    <h2>Entry and Exit Logs</h2>
    <button id="connect">Connect</button>
    <table id="mytable" class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>Log ID</th>
                <th>Guard ID</th>
                <th>Time</th>
                <th>Log Type</th>
                <th>RFID No.</th>
                <th>Plate No.</th>
                <th>Full Name</th>
            </tr>
        </thead>
    </table>
</div>
<div style="display:flex">
    @using (Html.BeginForm("ExportExcel", "GuardMenu", FormMethod.Post))
    {
        <input type="submit" class="btn - btn-success" style="padding:5px; margin-right:5px;" value="Export as Excel" />
    }
    <a asp-action="PrintLogs" asp-controller="GuardMenu" id="Print" class="btn - btn-success" style="padding:5px;margin-right:5px;">Export as Pdf</a>
    <a asp-action="_ClearLogs" asp-controller="GuardMenu" class="btn - btn-danger" style="padding:5px;margin-right:5px;">Clear Logs</a>
</div>

    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
<script>
    populate();
    let updatedvalue = 0;
   async function populate() { 
        if ($.fn.DataTable.isDataTable('#mytable')) {
            $('#mytable').DataTable().destroy();
        }
        $('#mytable tbody').empty();
        $.get('@Url.Action("GetEntryLogs","GuardMenu")', 
        function (data1) {
            updatedvalue = data1.length;
            var table = $('#mytable').DataTable({
                    data: data1,
                    columns: [{data: 'logID'}, { data: 'guardID' }, { data: 'time' }, { data: 'logType' }, { data: 'rfiD_number' }, { data: 'plateNo' }, { data: 'fullName' }]
            });
        });
    }
    var connection2 = new signalR.HubConnectionBuilder().withUrl("/chat").build();
    connection2.start().catch(function (err) {
    return console.error(err.toString());
});
    connection2.on("GetGuardLogSuccess", function (Message) {
    const notification = document.getElementById('notifications');
    notification.classList.remove('notification');
    notification.textContent = "";
    notification.classList.add('notification');
    notification.textContent = Message;
        populate();
        showToast('<i class="bx bxs-alarm-exclamation"></i> Gate Opening');
    setTimeout(() => {
        notification.classList.remove('notification');
        notification.textContent = "";
    }, 5000);
        setTimeout(() => {
            showToast('<i class="bx bxs-check-circle"></i> Gate Opened!');
            setTimeout(() => {
                showToast('<i class="bx bxs-alarm-exclamation"></i> Gate Closing');
                setTimeout(() => {
                    showToast('<i class="bx bxs-x-circle"></i> Gate Closed!');
                }, 3000);
            }, 3000);
        }, 3000);
        

});
connection2.on("GetGuardLogFail", function (Message) {
    const notification = document.getElementById('notifications');
    notification.classList.remove('notification');
    notification.textContent = "";
    notification.classList.add('notification');
    notification.textContent = Message;
    
    setTimeout(() => {
        notification.classList.remove('notification');
        notification.textContent = "";
    }, 5000);
});
    var readelay= true;
//read rfid
    $("#connect").on('click', function () { 
        readport();
    });
    var ports;
    async function readport() {
        if (ports == null) {
            ports = await requestport();
            await ports.open({ baudRate: 921600 });
        }
        if (ports.connected) {

                const textDecoder = new TextDecoder();
                const reader = port.readable.getReader();
                while (true) {
                    const { value, done } = await reader.read();
                    if (value) {
                    if (readelay) {
                        var text = textDecoder.decode(value)
                        var gettext = text.replace(/ /g, "");
                        $.post("@Url.Action("EntryLogging", "GuardMenu")",
                            {
                                rfid: gettext
                            },
                            function (data) {
                                if (data.success) {
                                    readelay = false;
                                    console.log(readelay);
                                    setTimeout(delayread, 12000);
                                }
                            });
                        }
                    }
                    if (done) {
                        console.log('[readLoop] DONE', done);
                        reader.releaseLock();
                        break;
                    }
                }
        }

    }
    function delayread() { 
        readelay = true;
    }
    async function requestport() {
        port = await navigator.serial.requestPort();
        return port;
    }
    let toastBox = document.getElementById('toastBox');
    function showToast(Message) {
        console.log(toastBox);
       let toast = document.createElement('div');
        toast.classList.add('toaster');
        toast.innerHTML = Message;
        toastBox.appendChild(toast);
        if (Message.includes('!')) {
            toast.classList.add('success');
        }
        if (Message.includes('Closed')) {
            toast.classList.add('error');
        }
        if (Message.includes('ing')) {
            toast.classList.add('invalid');
        }
        setTimeout(() => {
            toast.remove();
        }, 3000);
    }

</script>