@{
}
@model User_Account
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/Sign_up.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.2/css/all.min.css" />
</head>
<div class="container">
    <div class="wrapper">
        <div class="title"><span>Sign Up Form</span></div>
        <form method="post">
            @Html.AntiForgeryToken();
            <div class="row ">
                <i class="fas fa-envelope"></i>
                <input asp-for="Email" type="text" placeholder="Email" required>
                <span  asp-validation-for="Email" class="text-danger" style="margin:auto;"></span>
            </div>
            <div class="row ">
                <i class="fas fa-envelope"></i>
                <input asp-for="Username" type="text" id="Username" oninput="UserCheck()" placeholder="Username" required>
                <span asp-validation-for="Username" class="text-danger" style="margin:auto;"></span>
                <p id="Status"/>
            </div>
            <div class="row ">
                <i class="fas fa-lock"></i>
                <input asp-for="Password" type="password" placeholder="Password" required>
                <span asp-validation-for="Password" class="text-danger" style="margin:auto;"></span>
            </div>
            <div class="row button">
                <input id="button1" type="submit" value="Sign Up" style="margin-top:20px;">
            </div>
            <div class="signup-link"><a asp-controller="Login" asp-action="LoginForm">Back to Login</a></div>
        </form>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
    function UserCheck() {
        $("#Status").html("Checking...");
        $.post("@Url.Action("CheckUsername", "Login")",
            {
                userdata: $("#Username").val()
            },
            function (data) {
                if (data == 0) {
                    $("#Status").html('<font color = "Green"> Username Available!.</font>');
                    $("#Username").css("border-color", "Green");
                    $("#button1").removeAttr('disabled');
                }
                else{
                    $("#Status").html('<font color = "Red"> Username already Taken!.</font>');
                    $("#Username").css("border-color", "Green");
                    $("#button1").attr('disabled', 'disabled');
                }
            });
    }
</script>
@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}