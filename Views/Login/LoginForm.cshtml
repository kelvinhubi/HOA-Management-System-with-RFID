@model User_Account
@{
}
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        @{
            ViewData["Title"] = "User Login";
        }
    </title>
    <link rel="stylesheet" href="~/css/Login.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.2/css/all.min.css" />
</head>
<div class="container">
    <div class="wrapper">
        <div class="title"><span>Login Form</span></div>
        @Html.AntiForgeryToken()
        <form method="post">
            <div class="row">
                <i class="fas fa-user"></i>
                <input asp-for="Username"  type="text" placeholder="Email or Phone" required>
                <span asp-validation-for="Username" class="text-danger" style="margin:auto;"></span>
                @Html.ValidationMessage("UsernameError")
            </div>
            <div class="row">
                <i class="fas fa-lock"></i>
                <input asp-for="Password" type="password" placeholder="Password" required>
                <span asp-validation-for="Password" class="text-danger" style="margin:auto;"></span>
                @Html.ValidationMessage("PasswordError")
            </div>
            <div class="pass"><a asp-controller="Login" asp-action="UserForgotPassword" style="margin-top:10px;">Forgot password?</a></div>
            <div class="row button">
                <input type="submit" value="Login">
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}
