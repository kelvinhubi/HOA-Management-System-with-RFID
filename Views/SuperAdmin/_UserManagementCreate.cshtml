@model User_Account
<Button runat="server" id="bution" class="btn btn-success" >Create Admin Account</Button>
<form asp-action="View" class="form" id="thisform">
    <p class="title">Add Admin Account</p>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
     <input asp-for="AccountID" class="form-control input"  hidden />
    <div class="form-group">
        <label asp-for="Username" class="control-label"></label>
        <input asp-for="Username" class="form-control input"  oninput="UserCheck();" />
        <span asp-validation-for="Username" id="Status" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Email" class="control-label"></label>
        <input asp-for="Email" class="form-control input"  oninput="UserCheckEmail();" />
        <span asp-validation-for="Email" id="StatusEmail" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Password" class="control-label"></label>
        <input id="forpass" asp-for="Password" type="password" class="form-control input" readonly />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="form-group">
        <Button onclick="GeneratePass();" type="button" class="btn btn-secondary" style="margin-top:5px;margin-bottom:5px;">Generate Password</Button>
    </div>
    <div class="form-group">
        <input asp-controller="SuperAdmin" asp-action="CreatUserAcc" type="submit" id="button1" value="Create" class="btn btn-primary"  />
        <!--<div class="add">
            <div class="loading-wave">
                <div class="loading-bar"></div>
                <div class="loading-bar"></div>
                <div class="loading-bar"></div>
                <div class="loading-bar"></div>
            </div>
        </div>-->
    </div>
</form>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
    var btn = document.getElementById("bution")
    var text;
    $(".form").css("display", "none");
    btn.onclick = function () {
        if ($(".form").css("display") == "block") {
            $(".form").css("display", "none");
            $("#UserPartial").css("display", "block");
            
            $("#bution").html('Create User Account');
            $("body").css("background", "rgba(0, 0, 0, 0)");
            $('#forpass').val("")
        }
        else {
            this.blur();
            $(".form").css("display", "block"); 
            $("#UserPartial").css("display", "none");
            $("#bution").html('Hide');
            $("body").css("background", "rgba(0, 0, 0, 0.4)");

        }
    }

    function GeneratePass() {
        $.post("@Url.Action("GeneratePass", "MainMenu")", { userdata: $("#Username").val() },
            function (data) {
                $('#forpass').val(data)
            });
    }
    function UserCheck() {
        $("#Status").html("Checking...");
        $.post("@Url.Action("CheckUsername", "SuperAdmin")",
            {
                userdata: $("#Username").val()
            },
            function (data) {
                if (data == 0) {
                    $("#Status").html('<font color = "Green"> Username Available!.</font>');
                    $("#Username").css("border-color", "Green");
                    Username = true;
                }
                else {
                    $("#Status").html('<font color = "White"> Username already Taken!.</font>');
                    $("#Username").css("border-color", "Green");
                    Username = false;
                }
            });
    }
    function UserCheckEmail() {
        $("#StatusEmail").html("Checking...");
        $.post("@Url.Action("CheckUsernameEmail", "SuperAdmin")",
            {
                userdata: $("#Email").val()
            },
            function (data) {
                if (data == 0) {
                    $("#StatusEmail").html('<font color = "Green"> Email Available!.</font>');
                    $("#Email").css("border-color", "Green");
                    Email = true
                }
                else {
                    $("#StatusEmail").html('<font color = "White"> Email already Taken!.</font>');
                    $("#Email").css("border-color", "Green");
                    Email = false;
                }
            });
    }
    var Username = false;
    var Email = false;

    setInterval(Validation, 200);
    function Validation() {
        if (Username == true && Email == true) {
            $("#button1").removeAttr('disabled');
        } else {
            $("#button1").attr('disabled', 'disabled');
        }
    }
    //$("#button1").on('click', function () { 
        //$(".add").html('<div class="loading-wave"><div class="loading-bar"></div ><div class="loading-bar"></div><div class="loading-bar"></div><div class="loading-bar"></div></div>');
    //});
    
</script>