@model FacilityReservation
@{
    Layout = "~/Views/Shared/_Layout4.cshtml";
}
<head>
    <style>p {margin-top: 5px;}
        .btn-sm,.btn{margin-top:5px;}
    </style>
</head>
<form asp-action="_ReserveFacility" asp-controller="ResidentMenu" class="form" id="thisform" style="bottom:29rem; display:block">
    <p class="title">Reserve Facility</p>
    <input asp-for="AccountID"  class="form-control" hidden />
    <input asp-for="FacilityID" class="form-control" hidden />
    <input asp-for="ReservationID" class="form-control" hidden />
    <div>
        <div class="form-group">
            <label asp-for="DateOFReservation" class="form-label"></label>
            <input asp-for="DateOFReservation" type="date" class="form-control" readonly/>
        </div>
        <div class="form-group">
            <label asp-for="StartTime" class="form-label">Start Time</label>
            <input asp-for="StartTime" id="startDate" type="datetime-local" value="@DateTime.Now.ToString("yyyy-MM-dd hh:mm")" min="@DateTime.Now.ToString("yyyy-MM-dd hh:mm")" max="@DateTime.MaxValue.ToString("yyyy-MM-dd hh:mm")" class="form-control" />
        </div>
        <div class="form-group">
            <label asp-for="EndTime" class="form-label">End Time</label>
            <input asp-for="EndTime" id="endDate" type="datetime-local" value="@DateTime.Now.ToString("yyyy-MM-dd hh:mm")" min="@DateTime.Now.ToString("yyyy-MM-dd hh:mm")" max="@DateTime.MaxValue.ToString("yyyy-MM-dd hh:mm")" class="form-control" />
            <span>@Html.ValidationMessage("Reserved")</span>
        </div>
        <div class="form-group">
            <input type="submit" id="dis1" value="Save" class="btn btn-primary" />
         </div>
    </div>
</form>
<script>
    $("#startDate, #endDate").on('change', function () {
        const startDate = new Date($("#startDate").val());
        const endDate = new Date($("#endDate").val());

        // Ensure both dates are valid
        if (isNaN(startDate.getTime()) || isNaN(endDate.getTime())) {
            alert("Invalid date format. Please enter valid dates.");
            $("#dis1").attr('disabled', 'disabled');
            return;
        }

        // Compare dates, considering time as well
        if (endDate <= startDate) {
            alert("End Date must be after Start Date.");
            $("#dis1").attr('disabled', 'disabled');
        } else {
            $("#dis1").removeAttr('disabled');
        }
    });
</script>


