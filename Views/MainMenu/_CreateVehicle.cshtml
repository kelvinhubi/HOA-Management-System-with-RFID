@model Vehicle_Information
@{
    string[] typeofdue = { "Facilities", "Amortization", };
    IEnumerable<Homeowner_details>? ListOwners = ViewData["ListOwners"] as IEnumerable<Homeowner_details>;
}
<Button runat="server" id="bution" class="btn btn-primary" style="position:sticky;background-color:#16a085;color:black;">Add Vehicle</Button>
<form asp-action="View" class="form" id="thisform">
    <p class="title">Add Vehicle</p>
    <input asp-for="AccountID" value="" id="AccountID" class="form-control" hidden />
    <div class="form-group">
        <label asp-for="FullName" class="control-label">Select Homeowner</label>
        <select asp-for="FullName" onclick="CheckName()" class="form-control">
            @foreach (Homeowner_details obj in ListOwners)
            {

                var fullname = obj.Firstname + " " + obj.Middlename + " " + obj.Surname;
                <option id="FullName" value="@fullname">@fullname</option>
                <i class="arrow up"></i>
            }
        </select>
        <span asp-validation-for="AccountID" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="PlateNo" class="control-label"></label>
        <input asp-for="PlateNo" class="form-control input" />
        <span asp-validation-for="PlateNo" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="VehicleModel" class="control-label"></label>
        <input asp-for="VehicleModel" class="form-control input" />
        <span asp-validation-for="VehicleModel" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="VehicleType" class="control-label">Vehicle Type</label>
        <input asp-for="VehicleType" class="form-control input" />
    </div>
    <div class="form-group">
        <label asp-for="RFID_number" class="control-label">RFID Number</label>
        <input asp-for="RFID_number" id="RFIDnumber" class="form-control input" readonly/>
        <span asp-validation-for="RFID_number" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input asp-controller="MainMenu" asp-action="_CreateVehicle" type="submit" id="button1" value="Create" class="btn btn-primary" style="background-color:#16a085;color:black;" />
    </div>
</form>
<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script>
    var btn = document.getElementById("bution")
    $(".form").css("display", "none");
    btn.onclick = function () {
        if ($(".form").css("display") == "block") {
            $(".form").css("display", "none");
            $("#UserPartial").css("display", "block");
            $("#bution").html('Add Vehicle');
            document.getElementById("bution").style.cssText = "display: block; position: inherit; background-color:#16a085; color: black";
            $("body").css("background", "rgba(0, 0, 0, 0)");
            $('#forpass').val("")
            $("#forpass").attr('disabled', 'disabled');
        }
        else {
            this.blur();
            $(".form").css("display", "inline");
            CheckName();
            document.getElementById("bution").style.cssText = "position: fixed; background-color:#16a085;color:black;";
            $("#UserPartial").css("display", "none");
            $("#bution").html('Hide');
            $("body").css("background", "rgba(0, 0, 0, 0.4)");

        }
    }

    function CheckName() {
        $.post("@Url.Action("CheckName", "MainMenu")",
            {
                userdata: $("#FullName").val()
            },
            function (data) {
                if (data == 0) {

                }
                else {

                    $("#AccountID").val(data);

                }
            });
    }
    var isValue = false
    $("#RFIDnumber").on('click', function () {
        $(this).val("Listening...");
        Timer(5000);
        //do dome scanning on rfid
        $.get("@Url.Action("ReadRFID", "Rfid")", function (data) {
            if (data == 0) {
                isValue = false;
                console.log("should change value");
            }
            else{
                $("#RFIDnumber").val(data);
                isValue = true;
            }
        });
        
    });
    async function Timer(time) {
        setTimeout(function () {
            if (isValue == false) { 
                console.log("Hello");
                $("#RFIDnumber").val("N/A");
            }
        }, time);
    }
</script>