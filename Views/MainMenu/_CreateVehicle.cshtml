@model NewModel
@{
   
}
<Button runat="server" id="bution" class="btn btn-primary" style="position:sticky;background-color:#16a085;color:black;">Add Vehicle</Button>
<form asp-action="View" class="form" id="thisform">
    <p class="title">Add Vehicle</p>
    <input asp-for="@Model.Vehicle.AccountID" value="" id="AccountID" class="form-control" hidden />
    <div class="form-group">
        <label asp-for="@Model.Vehicle.FullName" class="control-label">Select Homeowner</label>
        <select asp-for="@Model.Vehicle.FullName" onclick="CheckName()" id="FullName" class="form-control">
            @foreach (Homeowner_details obj in Model.Homeacc)
            {

                var fullname = obj.Firstname + " " + obj.Middlename + " " + obj.Surname;
                <option value="@obj.FullName" data-another="@obj.AccountID">@fullname</option>
            }
        </select>
        <span asp-validation-for="@Model.Vehicle.AccountID" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="@Model.Vehicle.PlateNo" class="control-label"></label>
        <input asp-for="@Model.Vehicle.PlateNo" class="form-control input" />
        <span asp-validation-for="@Model.Vehicle.PlateNo" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="@Model.Vehicle.VehicleModel" class="control-label"></label>
        <input asp-for="@Model.Vehicle.VehicleModel" class="form-control input" />
        <span asp-validation-for="@Model.Vehicle.VehicleModel" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="@Model.Vehicle.VehicleType" class="control-label">Vehicle Type</label>
        <input asp-for="@Model.Vehicle.VehicleType" class="form-control input" />
    </div>
    <div class="form-group">
        <label asp-for="@Model.Vehicle.RFID_number" class="control-label">RFID Number</label>
        <input asp-for="@Model.Vehicle.RFID_number" id="RFIDnumber" class="form-control input" readonly />
        <span asp-validation-for="@Model.Vehicle.RFID_number" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input asp-controller="MainMenu" asp-action="_CreateVehicle" type="submit" id="button1" value="Create" class="btn btn-primary" style="background-color:#16a085;color:black;" />
    </div>
</form>
<script>
    var btn = document.getElementById("bution")
    $(".form").css("display", "none");
    btn.onclick = function () {
        if ($(".form").css("display") == "block") {
            $(".form").css("display", "none");
            $("#UserPartial").css("display", "block");
            $("#bution").html('Add Vehicle');
            document.getElementById("bution").style.cssText = "display: block; position: inherit; background-color:#16a085; color: black";
            $("body").css("background", "rgba(0, 0, 0, 0)");
            $('#forpass').val("")
            $("#forpass").attr('disabled', 'disabled');
        }
        else {
            this.blur();
            $(".form").css("display", "inline");
            CheckName();
            document.getElementById("bution").style.cssText = "position: fixed; background-color:#16a085;color:black;";
            $("#UserPartial").css("display", "none");
            $("#bution").html('Hide');
            $("body").css("background", "rgba(0, 0, 0, 0.4)");

        }
    }
    function CheckName() {
        var initialid = $("#FullName").find($("select option:selected")).data('another');
        console.log(initialid);
        $("#AccountID").val(initialid);
    }
    var isValue = false
    $("#RFIDnumber").on('click', function () {
        $(this).val("Listening...");
        Timer(5000);
        //do dome scanning on rfid
        $.get("@Url.Action("ReadRFID", "Rfid")", function (data) {
            if (data == 0) {
                isValue = false;
            }
            else {
                $("#RFIDnumber").val(data);
                isValue = true;
            }
        });
        $.get("@Url.Action("showPorts", "Rfid")", function (data) {
            if (data == 0) {
                console.log("data is 0");
            }
            else {
                console.log(data);
            }
        });

    });p         p
    async function Timer(time) {
        setTimeout(function () {
            if (isValue == false || $("#RFIDnumber").val() == "Listening...") {
                $("#RFIDnumber").val("N/A");
            }
        }, time);
    }
</script>