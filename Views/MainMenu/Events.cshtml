@model NewModel
@{
    Layout = "~/Views/Shared/_Layout1.cshtml";
    string[] choices = { "Daily", "Weekly", "Monthly", "Yearly" };
}
<head>
    <title>
        @{
            ViewData["Title"] = "User Management";
        }
    </title>
</head>
@Html.AntiForgeryToken();
<div id="UserPartial">
    <h2>Event List</h2>
    <table id="mytable" class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>Event Title</th>
                <th>Event Fee</th>
                <th>Event Date</th>
                <th>Registration Start Date</th>
                <th>Registration End Date</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var obj in Model.Events)
            {
                <tr>
                    <td>@obj.EventTitle</td>
                    @if (obj.EventFee != null)
                    {
                        <td>@obj.EventFee</td>
                    }
                    else
                    {
                        <td>Free</td>
                    }
                    <td>@obj.EventDate</td>
                    <td>@obj.EventStartDate</td>
                    <td>@obj.EventEndDate</td>
                    <td>

                        <a asp-action="_JoinedMembers" class="btn btn-success btn-sm" asp-route-id="@obj.EventID">Participants<i class='bx bxs-user-detail'></i></a>
                        <a asp-action="_EventDetails" class="btn btn-success btn-sm" asp-route-id="@obj.EventID">Details<i class='bx bxs-user-detail'></i></a>
                        <a asp-action="_EditEvents" class="btn btn-success btn-sm" asp-route-id="@obj.EventID">Edit<i class='bx bxs-user-detail'></i></a>
                        <a asp-action="_DeleteEvents" class="btn btn-danger btn-sm" asp-route-id="@obj.EventID">Delete<i class='bx bxs-trash'></i></a>
                    </td>

                </tr>
            }
        </tbody>
    </table>
</div>
<div style="display:flex">
<div class="CreateSingle" style="margin-left:5px;">
@{
    Events user = new Events();
    <partial name="_AddEvents" model="user" />
}
</div>
<div class="ExportPDF" style="margin-left:5px;">
    <Button runat="server" id="bution2" class="btn btn-success" style="position:sticky;">Export as PDF</Button>
    <form asp-action="_ExportExpensePDF" class="form form3" id="thisform" style="bottom:29rem; display:block">
        <p class="title">Export As PDF</p>
        <div class="form-group">
            <label for="startDate2" class="control-label">Start Date</label>
            <input id="startDate2" type="date" name="startDate" class="form-control input" required />
        </div>
        <div class="form-group">
            <label for="endDate2" class="control-label">End Date</label>
            <input id="endDate2" type="date" name="endDate" class="form-control input" required />
        </div>
        <div class="form-group">
            <label for="frequency" class="control-label">Time Frequency</label>
            <select name="frequency">
                @foreach (var items in choices)
                {
                    <option value="@items">@items</option>
                }
            </select>
        </div>
        <button class="btn btn-success" id="PdfButton" value="submit">Export</button>
    </form>
</div>
</div>
@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}
<script>
    new DataTable('#mytable');
    var btn11 = document.getElementById("bution2");
    $(".form3").css("display", "none");
    btn11.onclick = function () {
        if ($(".form3").css("display") == "block") {
            $(".form3").css("display", "none");
            $("#UserPartial").css("display", "block");
            $("#PaidDues").css("display", "block");
            $(".CreateMultiple").css("display", "block");
            $(".CreateSingle").css("display", "block");
            $(".ExportExcel").css("display", "block");
            $("#bution2").html('Export as PDF');
            $("body").css("background", "rgba(0, 0, 0, 0)");
            $('#forpass').val("")
            $("#forpass").attr('disabled', 'disabled');
        }
        else {
            this.blur();
            $(".form3").css("display", "block");
            $("#UserPartial").css("display", "none");
            $("#PaidDues").css("display", "none");
            $(".CreateMultiple").css("display", "none");
            $(".CreateSingle").css("display", "none");
            $(".ExportExcel").css("display", "none");
            $("#bution2").html('Hide');
            $("body").css("background", "rgba(0, 0, 0, 0.4)");

        }
    }
    $("#startDate").on('change', function () {

        $("#endDate").removeAttr('disabled');
    });
    $(".form3").on('change', function () {
        var fit_start_time = $("#startDate").val();
        var fit_end_time = $("#endDate").val();
        if (new Date(fit_end_time) < new Date(fit_start_time)) {
            $("#PdfButton").attr('disabled', 'disabled');
            alert("End Date must be greater than start date");
        }
        else {
            $("#PdfButton").removeAttr('disabled');
        }
    });
</script>