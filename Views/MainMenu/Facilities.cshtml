@model NewModel
@{
    Layout = "~/Views/Shared/_Layout1.cshtml";
    string[] choices = { "Daily", "Weekly", "Monthly", "Yearly" };
}
<head>
    <title>
        @{
            ViewData["Title"] = "Facilities";
        }
    </title>
</head>
<div id="UserPartial">
    <h2>Facilities</h2>
    <table id="mytable" class="table">
        <thead class="table-light">
            <tr>
                <th>Facility Name</th>
                <th>Rental Fee</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
           @foreach (var obj in Model.facilities)
            {
                <tr>
                    <td>@obj.FacilityName</td>
                    <td>@obj.RentalFee</td>
                    <td>

                        <a asp-action="_FacilityDetails" class="btn btn-success btn-sm" asp-route-id="@obj.FacilityID">Details<i class='bx bxs-user-detail'></i></a>
                        <a asp-action="_EditFacility" class="btn btn-success btn-sm" asp-route-id="@obj.FacilityID">Edit<i class='bx bxs-user-detail'></i></a>
                        <a asp-action="_DeleteFacility" class="btn btn-danger btn-sm" asp-route-id="@obj.FacilityID">Delete<i class='bx bxs-trash'></i></a>
                    </td>
                </tr>
            }

        </tbody>
    </table>
</div>
<div id="UserPartial2">
    <h2>Reserved Facilities</h2>
    <table id="mytable" class="table">
        <thead class="table-light">
            <tr>
                <th>Name </th>
                <th>Facility Reserved</th>
                <th>Date Reserved</th>
                <th>Start</th>
                <th>End</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var obj in Model.facilitiesreserved)
            {
                var obj2 = Model.Homeacc.FirstOrDefault(_ => _.AccountID == obj.AccountID);
                if (obj2 != null)
                {
                    var obj3 = Model.facilities.FirstOrDefault(_ => _.FacilityID == obj.FacilityID);
                    <tr>
                        <td>@obj2.FullName</td>
                        @if (obj3 != null)
                        {
                            <td>@obj3.FacilityName</td>
                        }
                        else
                        {
                            <td></td>
                        }
                        <td>@obj.DateOFReservation</td>
                        <td>@obj.StartTime.ToString("MMM dd, yyyy hh:mm tt")</td>
                        <td>@obj.EndTime.ToString("MMM dd, yyyy hh:mm tt")</td>
                    </tr>
                }
            }

        </tbody>
    </table>
</div>
<div style="display:flex">
    <div class="CreateSingle" style="margin-left:5px;">
@{
    Facilities user = new Facilities();
    <partial name="_AddFacility" model="user" />
}
</div>
<div class="ExportPDF" style="margin-left:5px;">
    <Button runat="server" id="bution2" class="btn btn-success" style="position:sticky;">Export as PDF</Button>
        <form asp-action="_ExportFacilityPDF" class="form form3" id="thisform" style="bottom:29rem; display:block">
        <p class="title">Export As PDF</p>
        <div class="form-group">
            <label for="startDate2" class="control-label">Start Date</label>
                <input id="startDate" type="date" name="startDate"  class="form-control input" required />
        </div>
        <div class="form-group">
            <label for="endDate2" class="control-label">End Date</label>
                <input id="endDate" type="date" name="endDate"  class="form-control input" required />
        </div>
        <div class="form-group">
            <label for="frequency" class="control-label">Time Frequency</label>
            <select name="frequency">
                @foreach (var items in choices)
                {
                    <option value="@items">@items</option>
                }
            </select>
        </div>
        <button class="btn btn-success" id="PdfButton" value="submit">Export</button>
    </form>
</div>
</div>
@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}
<script>
    new DataTable('#mytable');
    var btn11 = document.getElementById("bution2");
    $(".form3").css("display", "none");
    btn11.onclick = function () {
        if ($(".form3").css("display") == "block") {
            $(".form3").css("display", "none");
            $("#UserPartial").css("display", "block");
            $("#UserPartial2").css("display", "block");
            $("#PaidDues").css("display", "block");
            $(".CreateMultiple").css("display", "block");
            $(".CreateSingle").css("display", "block");
            $(".ExportExcel").css("display", "block");
            $("#bution2").html('Export as PDF');
            $("body").css("background", "rgba(0, 0, 0, 0)");
            $('#forpass').val("")
            $("#forpass").attr('disabled', 'disabled');
        }
        else {
            this.blur();
            $(".form3").css("display", "block");
            $("#UserPartial").css("display", "none");
            $("#UserPartial2").css("display", "none");
            $("#PaidDues").css("display", "none");
            $(".CreateMultiple").css("display", "none");
            $(".CreateSingle").css("display", "none");
            $(".ExportExcel").css("display", "none");
            $("#bution2").html('Hide');
            $("body").css("background", "rgba(0, 0, 0, 0.4)");

        }
    }
    $("#startDate").on('change', function () {

        $("#endDate").removeAttr('disabled');
    });
    $(".form3").on('change', function () {
        var fit_start_time = $("#startDate").val();
        var fit_end_time = $("#endDate").val();
        if (new Date(fit_end_time) < new Date(fit_start_time)) {
            $("#PdfButton").attr('disabled', 'disabled');
            alert("End Date must be greater than start date");
        }
        else {
            $("#PdfButton").removeAttr('disabled');
        }
    });
</script>
