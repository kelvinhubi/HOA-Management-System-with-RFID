@using Cessna_HOA_MANAGEMENT_SYSTEM_WITH_RFID.Models;
@model NewModel
@{
    Layout = "~/Views/Shared/_Layout1.cshtml";
}
<head>
    <title>
        @{
            ViewData["Title"] = "Association Dues";
        }
    </title>
</head>
<div id="UserPartial">
    <h2>Association Dues </h2>
    <table id="mytable" class="table table-bordered" style="width:100%">
        <thead class="table-light">
            <tr>
                <th>Full Name</th>
                <th>Amount</th>
                <th>Included Fees</th>
                <th>Due Date</th>
                <th>Type of Due</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Dues obj in Model.ListDues)
            {
                <tr>
                    <td>@obj.FullName</td>
                    <td>@obj.Amount</td>
                    <td>@obj.FeesName</td>
                    <td id="duedate">@obj.Date</td>
                    <td>@obj.TypeofDues</td>
                    <td>@obj.Status</td>
                </tr>
            }

        </tbody>
    </table>

</div>
<div style="display:flex">
    <div class="CreateSingle">
        @{
            <partial name="_CreateDues" model="Model" />
        }
    </div>
    <div class="CreateMultiple">
        @{
            <partial name="_CreateDuesMultiple" model="Model" />
        }
    </div>
    <Button id="PaidDues" asp-action="_ClearPaid" class="btn btn-danger" style="margin-left:5px;">Clear Paid Dues</Button>
</div>

@section Scripts {
    @{
                                    <partial name="_ValidationScriptsPartial" />
    }
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
    new DataTable('#mytable');
    window.onload = function () { 
        var table = document.querySelectorAll("td");
        console.log(table.length);
        for (let i = 0; i < table.length; i++) { 
            let col = table[i].innerHTML;
            if (col == "Unpaid") { 
                table[i].classList.add('bx', 'bxs-user-x', 'card-danger','bg-danger')
                table[i].style.cssText = "font-size:15px;"
            }
            if (col == "Paid") { 
                table[i].classList.add('bx', 'bxs-user-x', 'card-success', 'bg-success')
                table[i].style.cssText = "font-size:14px;"
            }
        }

        var table = document.querySelectorAll("#duedate");
        for (let i = 0; i < table.length; i++) {
            let col = table[i].innerHTML
            var due = new Date(col)
            var date = new Date()
            if (due.getDate() <= date.getDate() && due.getMonth <= date.getMonth && due.getFullYear() <= date.getFullYear()) {
                table[i].classList.add('bx','bxs-error-alt','card-warning','bg-warning')
            }
            else { console.log("false")}
            
        }
    }
    $(document).ready(function () {
        $(document,"dt-column-title").on('click change',function () {
            var table = document.querySelectorAll("td");
            console.log(table.length);
            for (let i = 0; i < table.length; i++) {
                let col = table[i].innerHTML;
                if (col == "Unpaid") {
                    table[i].classList.add('bx', 'bxs-user-x', 'card-danger', 'bg-danger')
                    table[i].style.cssText = "font-size:15px;"
                }
                if (col == "Paid") {
                    table[i].classList.add('bx', 'bxs-user-x', 'card-success', 'bg-success')
                    table[i].style.cssText = "font-size:14px;"
                }
            }

            var table = document.querySelectorAll("#duedate");
            for (let i = 0; i < table.length; i++) {
                let col = table[i].innerHTML
                var due = new Date(col)
                var date = new Date()
                if (due.getDate() <= date.getDate() && due.getMonth <= date.getMonth && due.getFullYear() <= date.getFullYear()) {
                    table[i].classList.add('bx', 'bxs-error-alt', 'card-warning', 'bg-warning')
                }
                else { console.log("false") }

            }
        })
    });


</script>