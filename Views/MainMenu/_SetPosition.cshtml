@model Officers

@{
    Layout = "~/Views/Shared/_Layout1.cshtml";
    ViewData["Title"] = "Edit Position";
}
<form asp-action="_SetPosition" class="form" id="thisform" style="bottom:29rem; display:block">
    <p class="title">Set Position</p>
    <input type="hidden" asp-for="ID" />
    <input type="hidden" asp-for="AccountID" />
    <div class="form-group">
        <label asp-for="Position" class="control-label"></label>
        <input asp-for="Position" class="form-control"  class="input" />
        <span asp-validation-for="Position" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input type="submit" id="SubmitForm" value="Save" class="btn btn-primary" />
    </div>
</form>

<div>
    <a asp-action="Officers" class="btn btn-success" style="padding:5px; position:fixed">Back</a>
</div>