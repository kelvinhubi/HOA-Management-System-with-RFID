@model NewModel

@{
    Layout = "~/Views/Shared/_Layout1.cshtml";
}
<head>
    <title>
        @{
            ViewData["Title"] = "My Pets";
        }
    </title>
</head>
<div id="UserPartial">
    <h2>Pets</h2>
    <table id="mytable" class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>Pet ID</th>
                <th>Pet Owner</th>
                <th>Name</th>
                <th>Type of Pet</th>
                <th>Pet Age</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var obj in Model.pets)
            {
                var obj2 = Model.Homeacc.FirstOrDefault(_ => _.AccountID == obj.AccountID);
                <tr>
                    <td>@obj.PetId</td>
                    <td>@obj2.FullName</td>
                    <td>@obj.Name</td>
                    <td>@obj.Species</td>
                    <td>@obj.Age</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<script>
    new DataTable('#mytable');
</script>