@model FeesList

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}

<form asp-action="_DeleteFees" class="form" id="thisform" style="bottom:29rem; display:block">
    <p class="title">Delete Fees?</p>
            <input type="hidden" asp-for="IDFees" />
            <div class="form-group">
                <label asp-for="FeesName" class="control-label">Name of Due</label>
                <input asp-for="FeesName" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label asp-for="TypeOfFees" class="control-label">Name of Due</label>
                <input asp-for="TypeOfFees" class="form-control" readonly/>
            </div>
            <div class="form-group">
                <label asp-for="Amount" class="control-label"></label>
                <input asp-for="Amount" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label asp-for="Status" class="control-label">Status</label>
                <input asp-for="Status" class="form-control" readonly />
            </div>
            <div class="form-group">
                <input type="submit" value="Delete" class="btn btn-primary" />
            </div>
</form>

<div>
    <a asp-action="Fees" class="btn btn-success" style="padding:5px; position:fixed">Back to List</a>
</div>
