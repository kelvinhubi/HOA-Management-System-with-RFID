@model NewModel
@{
    Layout = "~/Views/Shared/_Layout1.cshtml";
    Homeowner_details details = Model.Homeowner;
    int Year = Convert.ToInt32(details.Birthdate.Year);
    int Age = Convert.ToInt32(DateTime.Today.Year) - Year;
    string cars = Model.Vehicles.Count() == 0 ? "N/A":Model.Vehicles.Count().ToString();
    string ownedhomes = Model.Homes.Count() == 0 ? "N/A" : Model.Homes.Count().ToString();
}
<div id="UserPartial">
    <h2>User Details</h2>
    <table class="table">
        <thead class="table-light">
            <tr>
                <th>Full Name</th>
                <th>Phone Number</th>
                <td>Age</td>
                <th>Owned Homes</th>
                <th>Cars</th>
                <th>RFID_number</th>
            </tr>
        </thead>
        <tbody>
                <tr>
                <td>@Html.DisplayFor(m => m.Homeowner.Firstname) @Html.DisplayFor(m => m.Homeowner.Middlename) @Html.DisplayFor(m => m.Homeowner.Surname)</td>
                <td>@Html.DisplayFor(m => m.Homeowner.PhoneNo)</td>
                <td>@Age</td>
                <td>@ownedhomes</td>
                <td>@cars</td>
                <td>@Html.DisplayFor(m => m.Homeowner.RFID_number)</td>
                </tr>
        </tbody>
        
    </table>
    
    <form asp-action="_UserManagementDetails">
        <p style="margin-bottom:0px;">Fees Option:</p>
        <input type="hidden" name="ID" value="@Html.DisplayFor(m => m.Homeowner.AccountID)" />
        @{
            for (int i = 0; i < Model.CheckMe.Count(); i++)
            {
                                    <input  asp-for="@Model.CheckMe[i].ID" hidden/>
                                    <label for="@Model.CheckMe[i].FeesName">@Model.CheckMe[i].FeesName</label>
                                    <input asp-for="@Model.CheckMe[i].FeesName" hidden/>
                                    <input  asp-for="@Model.CheckMe[i].IsChecked" type="checkbox"/>
            }
        }
        <div class="add">
            
            <a class="btn btn-success" id="Back" asp-controller="MainMenu" asp-action="UserManagement">Back to Accounts</a>
        </div>
        
    </form>
   
    
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>

        $("input").on('click',function () {
            $("#Back").remove();
        htmlStr = "";
        htmlStr += '<input type="submit" value="Save" class="btn btn-primary"/>';
        htmlStr += '<input type="reset" value="Cancel" onclick="Hello()" class="btn btn-danger"/>';
        $(".add").html(htmlStr);
            
        });

    function Hello() { 
        $(".btn").remove();
        htmlStr = "";
        htmlStr += '<a class="btn btn-success" id="Back" onclick="GoBack()">Back to Accounts</a>';
        $(".add").html(htmlStr);
        $("form").trigger("reset");
    }
    
    function GoBack() { 
        window.location.href = '@Url.Action("UserManagement","MainMenu")';
    }
</script>