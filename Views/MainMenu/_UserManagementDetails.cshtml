@model NewModel
@{
    Layout = "~/Views/Shared/_Layout1.cshtml";
    Homeowner_details details = Model.Homeowner;
    int Year = Convert.ToInt32(details.Birthdate.Year);
    int Age = Convert.ToInt32(DateTime.Today.Year) - Year;
}
<div id="UserPartial">
    <h2>User Details</h2>
    <table class="table">
        <thead class="table-light">
            <tr>
                <th>Full Name</th>
                <th>Phone Number</th>
                <td>Age</td>
                <td>Block No</td>
                <td>Lot No</td>
                <td>RFID_number</td>
            </tr>
        </thead>
        <tbody>
                <tr>
                <td>@Html.DisplayFor(m => m.Homeowner.Firstname) @Html.DisplayFor(m => m.Homeowner.Middlename) @Html.DisplayFor(m => m.Homeowner.Surname)</td>
                <td>@Html.DisplayFor(m => m.Homeowner.PhoneNo)</td>
                    <td>@Age</td>
                <td>@Html.DisplayFor(m => m.Homeowner.BlkNO)</td>
                <td>@Html.DisplayFor(m => m.Homeowner.Address)</td>
                <td>@Html.DisplayFor(m => m.Homeowner.RFID_number)</td>
                </tr>
        </tbody>
        
    </table>
    @{
        foreach (var items in Model.CheckBoxItems)
        {
            <label asp-for="@items.FeesName">@items.FeesName</label>
            <input asp-for="@items.IsChecked" />
       }
    }
    <a class="btn btn-primary" asp-controller="MainMenu" asp-action="UserManagement" style="background-color:#16a085;color:black;">Back to Accounts</a>
</div>
