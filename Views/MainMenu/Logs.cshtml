@model IEnumerable<LogsList>
@{
    Layout = "~/Views/Shared/_Layout1.cshtml";
}
<div id="UserPartial">
    <h2>Logs </h2>
    <table id="mytable" class="table table-bordered" style="width:100%">
        <thead class="table-light">
            <tr>
                <th>Log Name</th>
                <th>Log Description</th>
                <th>User Role</th>
                <th>Log Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var obj in Model)
            {
                <tr>
                    <td>@obj.LogName</td>
                    <td>@obj.LogDescription</td>
                    <td>@obj.LogUserRole</td>
                    <td>@obj.LogDate</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<a asp-action="PrintLogs" class="btn - btn-primary" style="background-color:#16a085;color:black; padding:5px;" >PrintLogs</a>