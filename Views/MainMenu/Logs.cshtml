@model IEnumerable<LogsList>
@{
    Layout = "~/Views/Shared/_Layout1.cshtml";
}
<head>
    <title>
        @{
            ViewData["Title"] = "Logs";
        }
    </title>
</head>
<div id="UserPartial">
    <h2>Logs </h2>
    <table id="mytable" class="table table-bordered" style="width:100%">
        <thead class="table-light">
            <tr>
                <th>Log Name</th>
                <th>Log Description</th>
                <th>User Role</th>
                <th>Log Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var obj in Model)
            {
                <tr>
                    <td>@obj.LogName</td>
                    <td>@obj.LogDescription</td>
                    <td>@obj.LogUserRole</td>
                    <td>@obj.LogDate</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div style="display:flex">
    @using (Html.BeginForm("ExportExcel", "MainMenu", FormMethod.Post))
    {
        <input type="submit" class="btn - btn-success" style="padding:5px; margin-right:5px;" value="Export as Excel" />
    }
    <a asp-action="PrintLogs" id="Print" class="btn - btn-success" style="padding:5px;margin-right:5px;">Export as Pdf</a>
    <a asp-action="_ClearLogs" class="btn - btn-danger" style="padding:5px;margin-right:5px;">Clear Logs</a>
</div>
<script>
    new DataTable('#mytable');
</script>