@model NewModel
@{
    Layout = "~/Views/Shared/_Layout1.cshtml";

}
<head>
    <title>
        @{
            ViewData["Title"] = "User Management";
        }
    </title>
</head>
@Html.AntiForgeryToken();
<div id="UserPartial">
    <h2>Event Members</h2>
    <table id="mytable" class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Contact No.</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var obj in Model.EventsReserved)
            {
                if (obj != null)
                {

                    var obj2 = Model.Homeacc.FirstOrDefault(_ => _.AccountID == obj.AccountID);
                    if (obj2 != null)
                    {
                        <tr>
                            <td>@obj2.FullName</td>
                            <td>@obj2.PhoneNo</td>
                        </tr>

                    }
                }
            }
        </tbody>
    </table>
</div>
<div>
    <a asp-action="Events" class="btn btn-success" style="padding:5px; position:fixed">Back to List</a>
</div>