@model NewModel
@{
    Layout = "~/Views/Shared/_Layout1.cshtml";
}
<head>
    <title>
        @{
            ViewData["Title"] = "Vehicle Management";
        }
    </title>
</head>
<div id="UserPartial">
    <h2>Vehicle Management </h2>
    <table id="mytable" class="table">
        <thead class="table-light">
            <tr>
                <th>VehicleID</th>
                <th>Full Name</th>
                <th>Plate No.</th>
                <th>Vehicle Model</th>
                <th>Vehicle Type</th>
                <th>RFID No.</th>
                <th>RFID Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var obj in Model.Vehicles)
            {
                <tr>
                    @{var rfid = obj.RFID_number != string.Empty ? obj.RFID_number : "N/A";}
                    <td>@obj.VehicleID</td>
                    <td>@obj.FullName</td>
                    <td>@obj.PlateNo</td>
                    <td>@obj.VehicleModel</td>
                    <td>@obj.VehicleType</td>
                    <td>@rfid</td>
                    <td>@obj.RFID_status</td>
                    <td>
                        <a asp-action="_EditVehicle" asp-route-ID="@obj.VehicleID" class="btn btn-success btn-sm">Edit<i class='bx bxs-edit-alt'></i></a>
                        <a asp-action="_DeleteVehicle" asp-route-ID="@obj.VehicleID" class="btn btn-danger btn-sm">Delete<i class='bx bxs-trash'></i></a>
                    </td>
                </tr>
            }

        </tbody>
    </table>
</div>
@{
    <partial name="_CreateVehicle" model="Model" />
}
@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}
<script>
    new DataTable('#mytable');
</script>





