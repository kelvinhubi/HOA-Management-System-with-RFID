@model NewModel

<Button runat="server" id="bution" class="btn btn-success" style="position:sticky;">Create Dues</Button>
<form method="post" class="form" id="thisform">
    <p class="title">Add Dues</p>
    <input asp-for="@Model.dues.AccountID" name="AccountID" id="AccountID" class="form-control" hidden />
    <input asp-for="@Model.dues.Status" name="Status" class="form-control" hidden />
    <div class="form-group">
        <label asp-for="@Model.dues.FullName" class="control-label">Select Homeowner</label>
        <select asp-for="@Model.dues.FullName" onclick="CheckName();CheckFees()" id="FullName" class="form-control">
            @foreach (var obj in Model.Homeacc)
            {
                <option  value="@obj.FullName" data-another="@obj.AccountID">@obj.FullName</option>
            }
        </select>
        <span asp-validation-for="@Model.dues.AccountID" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="@Model.dues.Amount" class="control-label"></label>
        <input asp-for="@Model.dues.Amount" name="Amount" class="form-control input" id="Amount" readonly />
        <span asp-validation-for="@Model.dues.Amount" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="@Model.dues.TypeofDues" class="control-label">Type of Due</label>
        <select asp-for="@Model.dues.TypeofDues" name="TypeofDues" onclick="CheckAmount()" id="Typeoffees" class="form-control">
            <option></option>
        </select>
    </div>
    <div class="form-group">
        <label asp-for="@Model.dues.Date"  class="control-label">Set Due Date</label>
        <input asp-for="@Model.dues.Date" type="date" name="Date" class="form-control input" />
        <span asp-validation-for="@Model.dues.Date" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input asp-controller="MainMenu" asp-action="_CreateDues" type="submit" id="button1" value="Create" class="btn btn-primary"/>
    </div>
</form>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
    var btn = document.getElementById("bution")
    $(".form").css("display", "none");
    btn.onclick = function () {
        if ($(".form").css("display") == "block") {
            $(".form").css("display", "none");
            $("#UserPartial").css("display", "block");
            $("#PaidDues").css("display", "block");
            $("#bution").html('Create Dues'); 
            document.getElementById("bution").style.cssText = "display: block; position: inherit; background-color:#16a085; color: black";
            $("body").css("background", "rgba(0, 0, 0, 0)");
            $('#forpass').val("")
            $("#forpass").attr('disabled', 'disabled');
        }
        else {
            this.blur();
            $(".form").css("display", "block");
            CheckName();
            CheckFees();
            document.getElementById("bution").style.cssText = "position: fixed; background-color:#16a085;color:black;";
            $("#UserPartial").css("display", "none");
            $("#PaidDues").css("display", "none");
            $("#bution").html('Hide');
            $("body").css("background", "rgba(0, 0, 0, 0.4)");

        }
    }

    function CheckName() {
        $.post("@Url.Action("CheckName", "MainMenu")",
            {
                userdata: $("#FullName").val()
            },
            function (data) {
                if (data == 0) {
                }
                else {

                    $("#AccountID").val(data);
                }
            });
    }
    
    function CheckAmount() {
        var initialid = $("#Typeoffees").find($("select option:selected")).data('another2');;
        var id = $("#Typeoffees").find($("select option:selected")).data('another1');
        $.post("@Url.Action("CheckAmount", "MainMenu")",
            {
                userdata: id,
                AccountID: initialid
            },
            function (data) {
                if (data == 0) {
                }
                else {

                    $("#Amount").val(data);
                }
            });
    }
    function CheckFees() {
        
        var id = $("#FullName").find($("select option:selected")).data('another');
        $.post("@Url.Action("CheckFees", "MainMenu")",
            {
                userdata: id
            },
            function (data) {
                if (data == 0) {
                    $("#Typeoffees").find('option').remove().end();
                    $("#Typeoffees").append('<option></option>');
                    $("#Amount").val("");
                }
                else {
                    console.log("Check Fees:" + data[0].typeOfFees);
                    $("#Typeoffees").find('option').remove().end();
                    var recentvar = "";
                    for (var j = 0; j < data.length; j++) {
                        console.log(data[j].userFeeID);
                        if(recentvar != data[j].typeOfFees){
                            recentvar = data[j].typeOfFees;
                            $("#Typeoffees").append('<option value="' + data[j].typeOfFees + '" data-another1="' + data[j].typeOfFees + '" data-another2="' + data[j].accountID + '">' + data[j].typeOfFees + '</option>');
                        }
                        
                    }
                    $("#Typeoffees").val("");
                }
            });
    
    }
    function Clear() { 
            
        $("#Amount").val("0");
        
    }
</script>
