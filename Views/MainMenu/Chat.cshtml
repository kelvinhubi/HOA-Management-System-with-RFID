<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
<script src="~/js/Hub.js"></script>
<script>
    window.onload = function () { 
        $.get('@Url.Action("GetSessionName","Login")', function (data) {
            $('#Nameval').val(data);
        });
    }
</script>