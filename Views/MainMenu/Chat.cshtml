@model NewModel
@{
    Layout = "~/Views/Shared/_Layout1.cshtml";
}
<div class="card direct-chat direct-chat-primary mb-4">

    <div class="card-header">
        <h3 class="card-title">Chat</h3>
    </div> <!-- /.card-header -->
    <div class="card-body">
        <input id="Nameval"value="" hidden/>
        <!-- Conversations are loaded here -->
        <div class="direct-chat-messages" id="pops">
            
            
        </div> <!-- /.direct-chat-messages--> <!-- Contacts are loaded here -->
    </div> <!-- /.card-body -->
    <div class="card-footer">
        <form action="#" method="post">
            <div class="input-group">
                <input type="text" name="message" id="message" placeholder="Type Message ..." class="form-control"> <span class="input-group-append">
                    <button type="button" id="sendmessage" class="btn btn-primary">
                        Send
                    </button>
                </span>
            </div>
        </form>
    </div> <!-- /.card-footer-->
</div>
