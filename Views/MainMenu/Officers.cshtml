@model NewModel
@{
    Layout = "~/Views/Shared/_Layout1.cshtml";
}
<head>
    <title>
        @{
            ViewData["Title"] = "Officers";
        }
    </title>
</head>
<div id="UserPartial">
    <h2>Officers </h2>
    <table id="mytable" class="table">
        <thead class="table-light">
            <tr>
                <th>Homeowner Name</th>
                <th>Position</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var obj in Model.Homeacc)
            {
                var obj2 = Model.Officers.FirstOrDefault(_ => _.AccountID == obj.AccountID);
                <tr>
                    <td>@obj.FullName</td>
                    @if (obj2 != null)
                    {
                        if (obj2.Position != string.Empty)
                        {
                            <td>
                                @obj2.Position
                            </td>
                            <td>
                                <a asp-action="_EditPosition" asp-route-ID="@obj2.ID" class="btn btn-success btn-sm">Edit Position<i class='bx bxs-edit-alt'></i></a>
                                <a asp-action="_DeletePosition" asp-route-ID="@obj2.ID" class="btn btn-danger btn-sm">Remove Position<i class='bx bxs-trash'></i></a>
                            </td>
                        }


                    }
                    else
                    {
                        <td>
                            N/A
                        </td>
                        <td>
                            <a asp-action="_SetPosition" asp-route-ID="@obj.AccountID" class="btn btn-success btn-sm">Set Position</a>
                        </td>
                    }

                </tr>
            }

        </tbody>
    </table>
</div>
<script>
    new DataTable('#mytable');
</script>