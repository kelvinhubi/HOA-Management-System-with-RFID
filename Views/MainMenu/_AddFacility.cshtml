@model Facilities

<Button runat="server" id="bution" class="btn btn-success" style="position:sticky;">Add Facility</Button>
<form asp-action="_AddFacility" asp-controller="MainMenu" class="form" id="thisform">
    <p class="title">Add Facility</p>
    <input asp-for="FacilityID" class="form-control" hidden />
    <div class="form-group">
        <label asp-for="FacilityName" class="control-label">Facility Name</label>
        <input asp-for="FacilityName" class="form-control" />
        <span asp-validation-for="FacilityName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="RentalFee" class="control-label">Rental Fee</label>
        <input asp-for="RentalFee" class="form-control" number/>
        <span asp-validation-for="RentalFee"></span>
    </div>

    <div class="form-group">
        <input type="submit" value="Create" class="btn btn-success" />
    </div>
</form>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
    var btn = document.getElementById("bution")
    $("#thisform").css("display", "none");
    btn.onclick = function () {
        if ($("#thisform").css("display") == "block") {
            $("#thisform").css("display", "none");
            $("#UserPartial").css("display", "block");
            $("#UserPartial2").css("display", "none");
            $("#PaidDues").css("display", "block");
            $(".CreateMultiple").css("display", "block");
            $(".ExportPDF").css("display", "block");
            $(".ExportExcel").css("display", "block");
            $("#bution").html('Create Dues');
            $("body").css("background", "rgba(0, 0, 0, 0)");
            $('#forpass').val("")
            $("#forpass").attr('disabled', 'disabled');
        }
        else {
            this.blur();
            $("#thisform").css("display", "block");
            $("#UserPartial").css("display", "none");
            $("#UserPartial2").css("display", "none");
            $("#PaidDues").css("display", "none");
            $(".CreateMultiple").css("display", "none");
            $(".ExportPDF").css("display", "none");
            $(".ExportExcel").css("display", "none");
            $("#bution").html('Hide');
            $("body").css("background", "rgba(0, 0, 0, 0.4)");

        }
    }
</script>