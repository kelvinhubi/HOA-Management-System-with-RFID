@model IEnumerable<FeesList>
@{
    Layout = "~/Views/Shared/_Layout1.cshtml";
}
<head>
<title>
    @{
        ViewData["Title"] = "Fees";
    }
</title>
    <link rel=“stylesheet” href=“https://use.fontawesome.com/releases/v5.5.0/css/all.css” integrity=“sha384-B4dIYHKNBt8Bc12p+WXckhzcICo0wtJAoU8YZTY5qE0Id1GSseTk6S+L3BlXeVIU” crossorigin=“anonymous”>
</head>
<div id="UserPartial">
    <h2>Association Dues </h2>
    <table id="mytable" class="table">
        <thead class="table-light">
            <tr>
                <th>Fees Name</a></th>
                <th>Amount</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var obj in Model)
            {
                <tr>
                    <td>@obj.TypeOfFees</td>
                    <td>@obj.Amount</td>
                    <td>@obj.Status</td>
                    <td style="white-space:nowrap;">
                        <a class="btn btn-success btn-sm" asp-action="_EditFees" asp-route-id="@obj.IDFees">Edit<i class='bx bxs-edit-alt'></i></a>
                        <a asp-action="_DeleteFees" asp-route-id="@obj.IDFees" class="btn btn-danger btn-sm">Delete<i class='bx bxs-trash'></i></a>
                    </td>
                </tr>
            }

        </tbody>
    </table>
</div>
@{
    FeesList fees = new FeesList();
    <partial name="_CreateFees" model="fees"/>
}
@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
    new DataTable('#mytable');
    window.onload = function () {

    var table = document.querySelectorAll("td");
    for (let i = 0; i < table.length; i++) {
        let col = table[i].innerHTML;
        if (col == "Disabled") {
            table[i].classList.add('bx', 'bxs-user-x','bg-danger')
                table[i].style.cssText = "font-size:15px;margin-top:10px;margin-left:10px;"

        }
        if (col == "Enabled") {
            table[i].classList.add('bx', 'bxs-user-check', 'bg-success')
                table[i].style.cssText = "font-size:15px;margin-top:10px;margin-left:10px;"
        }
        }
    }
</script>