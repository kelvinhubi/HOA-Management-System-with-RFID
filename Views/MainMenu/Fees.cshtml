@model IEnumerable<FeesList>
@{
    Layout = "~/Views/Shared/_Layout1.cshtml";
}
<head>
<title>
    @{
        ViewData["Title"] = "Fees";
    }
</title>
</head>
<div id="UserPartial">
    <h2>Association Dues </h2>
    <table class="table">
        <thead class="table-light">
            <tr>
                <th>Fees Name</a></th>
                <th>Amount</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var obj in Model)
            {
                <tr>
                    <td>@obj.TypeOfFees</td>
                    <td>@obj.Amount</td>
                    <td>@obj.Status</td>
                    <td>
                        <a asp-action="_EditFees" class="btn btn-warning" asp-route-id="@obj.IDFees">Edit</a>
                        <a asp-action="_DeleteFees" class="btn btn-danger" asp-route-id="@obj.IDFees">Delete</a>
                    </td>
                </tr>
            }

        </tbody>
    </table>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
@{
    FeesList fees = new FeesList();
    <partial name="_CreateFees" model="fees"/>
}
@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}
<script>
    window.onload = function () {

    var table = document.querySelectorAll("td");
    for (let i = 0; i < table.length; i++) {
        let col = table[i].innerHTML;
        if (col == "Disabled") {
            table[i].classList.add('bx', 'bxs-user-x', 'card-danger','bg-danger')
            table[i].style.cssText = "font-size:15px;"
        }
        if (col == "Enabled") {
            table[i].classList.add('bx', 'bxs-user-x', 'card-success', 'bg-success')
            table[i].style.cssText = "font-size:14px;"
        }
        }


</script>