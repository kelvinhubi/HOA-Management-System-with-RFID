@model IEnumerable<Vehicle_Information>
@{
    Layout = "~/Views/Shared/_Layout1.cshtml";
}

<div id="UserPartial">
    <h2>Vehicle Management </h2>
    <table id="mytable" class="table">
        <thead class="table-light">
            <tr>
                <th>VehicleID</th>
                <th>Full Name</th>
                <th>Plate No.</th>
                <th>Vehicle Model</th>
                <th>Vehicle Type</th>
                <th>RFID No.</th>
                <th>RFID Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var obj in Model)
            {
                <tr>
                    <td>@obj.VehicleID</td>
                    <td>@obj.FullName</td>
                    <td>@obj.PlateNo</td>
                    <td>@obj.VehicleModel</td>
                    <td>@obj.VehicleType</td>
                    <td>@obj.RFID_number</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@obj.VehicleID">Details</a>
                        <a asp-action="_DeleteVehicle" asp-route-ID="@obj.VehicleID">Delete</a>
                    </td>
                </tr>
            }

        </tbody>
    </table>
</div>
@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
    new DataTable('#mytable');
</script>