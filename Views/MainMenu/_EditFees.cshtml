@model FeesList

@{
    Layout = "~/Views/Shared/_Layout1.cshtml";
    ViewData["Title"] = "Edit";
}

<form asp-action="_EditFees" class="form" id="thisform" style="bottom:29rem; display:block">
    <p class="title">Edit Fees?</p>
            <input type="hidden" asp-for="IDFees" />
            <div class="form-group">
                <label asp-for="FeesName" class="control-label"></label>
                <input asp-for="FeesName" class="form-control" id="FeesName" oninput="UserCheck()" class="input" />
                <span asp-validation-for="FeesName" id="Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TypeOfFees" class="control-label">Name of Due</label>
                <input asp-for="TypeOfFees" class="form-control" />
                <span asp-validation-for="TypeOfFees" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Amount" class="control-label"></label>
                <input asp-for="Amount" class="form-control" />
                <span asp-validation-for="Amount" class="text-danger"></span>

            </div>
            <div class="form-group">
                <label asp-for="Status" class="control-label"></label>
                <select asp-for="Status" onclick="CheckName();CheckFees()" class="form-control">
                        <option value="Enabled" >Enable</option>
                        <option value="Disabled">Disable</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" id="SubmitForm"value="Save" class="btn btn-primary" />
            </div>
        </form>

<div>
    <a asp-action="Fees" class="btn btn-success" style="padding:5px; position:fixed">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
<script>
    function UserCheck() {
        $("#Status").html("Checking...");
        $.post("@Url.Action("CheckFeesName", "MainMenu")",
            {
                userdata: $("#FeesName").val()
            },
            function (data) {
                if (data == 0) {
                    $("#Status").html('<font color = "Green"> FeesName Available!.</font>');
                    $("#FeesName").css("border-color", "Green");
                    $("#SubmitForm").removeAttr('disabled');
                }
                else {
                    $("#Status").html('<font color = "White"> FeesName already Exist!.</font>');
                    $("#FeesName").css("border-color", "Green");
                    $("#SubmitForm").attr('disabled', 'disabled');
                }
            });
    }
    </script>