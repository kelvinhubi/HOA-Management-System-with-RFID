@model Expenses
@{
    Layout = "~/Views/Shared/_Layout1.cshtml";
    ViewData["Title"] = "Edit Expense";
    string[] choices = { "Electricity", "Water", "Maintenance", "Manpower", "Other" };
}
<form asp-action="_EditExpense" class="form" id="thisform" style="bottom:29rem; display:block">
    <p class="title">Edit Expense</p>
    <input asp-for="ExpenseID" class="form-control" hidden />
    <div class="form-group">
        <label asp-for="EzpenseDate" class="control-label">Date</label>
        <input asp-for="EzpenseDate" type="date" class="form-control" />
        <span asp-validation-for="EzpenseDate"></span>
    </div>
    <div class="form-group">
        <label asp-for="PaymentMethod" class="control-label">Payment Method</label>
        <input asp-for="PaymentMethod" class="form-control" />
        <span asp-validation-for="PaymentMethod"></span>
    </div>
    <div class="form-group">
        <label asp-for="Description" class="control-label">Description</label>
        <input asp-for="Description" class="form-control input" />
        <span asp-validation-for="Description"></span>
    </div>
    <div class="form-group">
        <label asp-for="Category" class="control-label">Description</label>
        <select asp-for="Category" class="form-control input">
            @foreach (var item in choices)
            {
                <option value="@item">@item</option>
            }
        </select>
        <span asp-validation-for="Category"></span>
    </div>
    <div class="form-group">
        <label asp-for="Amount" class="control-label">Amount</label>
        <input asp-for="Amount" class="form-control input" number />
        <span asp-validation-for="Amount"></span>
    </div>
    <div class="form-group">
        <input type="submit" value="Save" class="btn btn-success" />
    </div>
</form>

<div>
    <a asp-action="Expenses" class="btn btn-success" style="padding:5px; position:fixed">Back to List</a>
</div>
@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}