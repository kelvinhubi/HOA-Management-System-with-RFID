@model NewModel
@{
    var setmin = DateTime.Now.ToString("yyyy-MM-dd");;
    var setmax = DateTime.MaxValue.ToString("yyyy-MM-dd");
}
<Button runat="server" id="bution1" class="btn btn-success" style="position:sticky;">Add Multiple Dues</Button>
<form method="post" class="form form2" id="thisform1">
    <p class="title">Add Multiple Dues</p>
    <input asp-for="@Model.dues.AccountID" name="AccountID" id="AccountID" class="form-control" hidden />
    <input asp-for="@Model.dues.Status" name="Status" class="form-control" hidden />
    <input asp-for="@Model.dues.FeesName" name="FeesName" id="FeesName" hidden />
    <div class="form-group">
        <label for="typeofdue" class="control-label">Select Type of Due</label>
        <select name="TypeofDues" id="typeofdue" class="form-control">
            @{
                var recentvar = "";
                foreach (var obj in Model.feesLists)
                {
                    if(!recentvar.Equals(obj.TypeOfFees)){
                    recentvar = obj.TypeOfFees;
                            <option value="@obj.TypeOfFees">@obj.TypeOfFees</option>
                    }
                }
            }
        </select>
    </div>
    <div class="form-group">
        <label class="control-label">Select Homeowner</label>
        <table class="table table-bordered" style="width:100%">
            <thead class="table-light">
                <tr>
                    <th><input type="checkbox" id="select-all"></th> <!-- Select All Checkbox -->
                    <th>Full Name</th>
                </tr>
            </thead>
            <tbody id="populate">
            </tbody>
        </table>
    </div>
    <div class="form-group">
        <label class="control-label">Set Due Date</label>
        <input type="date" name="date" min="@setmin" max="@setmax"id="dateinput" value="@setmin" class="form-control input" />
    </div>
    <div class="form-group">
        <input  type="button" id="CreateBatch" value="Create" class="btn btn-success" />
    </div>
</form>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>

    var btn = document.getElementById("bution1")
    $(".form2").css("display", "none");
    btn.onclick = function () {
        if ($(".form2").css("display") == "block") {
            $(".form2").css("display", "none");
            $("#UserPartial").css("display", "block");
            $("#PaidDues").css("display", "block");
            $(".CreateSingle").css("display", "block");
            $(".ExportOverallReportPDF").css("display", "block");
            $(".ExportPDF").css("display", "block");
            $(".ExportExcel").css("display", "block");
            $("#List").css("display", "block");
            $("#bution1").html('Add Multiple Dues');
            $("body").css("background", "rgba(0, 0, 0, 0)");
            $('#forpass').val("")
            $("#forpass").attr('disabled', 'disabled');
        }
        else {
            this.blur();
            checkdues();
            $(".form2").css("display", "block");
            $("#UserPartial").css("display", "none");
            $("#PaidDues").css("display", "none");
            $(".CreateSingle").css("display", "none");
            $(".ExportOverallReportPDF").css("display", "none");
            $(".ExportPDF").css("display", "none");
            $(".ExportExcel").css("display", "none");
            $("#List").css("display", "none");
            $("#bution1").html('Hide');
            $("body").css("background", "rgba(0, 0, 0, 0.4)");

        }
    }
    $("#CreateBatch").on('click', function () {
        var date = document.getElementById('dateinput').value;
        const selectedUserIds = getSelectedUserIds();
        if (selectedUserIds.length === 0) {
            alert('Please select at least one user.');
            return;
        }
        if(!date){
            alert('Please select date');
            return;
        }

        $.post('@Url.Action("AddDuesToUsers", "MainMenu")',
            {
                userIds: selectedUserIds,
                TypeofDues: $("#typeofdue").val(),
                date: $("#dateinput").val()
            },
            function (data) {
                if (data == 0) {
                    alert("Error Adding Batch process");
                }
                else {
                    location.reload();
                }
            })
    });
    $("#typeofdue").on('change', function () {
        checkdues();
     });

    function checkdues() { 
        $.post('@Url.Action("FindHomeOwners", "MainMenu")',
            {
                userdata: $("#typeofdue").val()
            },
            function (data) {
                if (data == 0) {
                    alert("No Homeowners found in the specified dues");
                    $("#populate").find('tr').remove().end();
                }
                else {
                    $("#populate").find('tr').remove().end();
                    for (var j = 0; j < data.length; j++) {
                        $("#populate").append('<tr><td><input type="checkbox" class="select-user" data-user-id="' + data[j].accountID + '"></td>' + '<td>' + data[j].fullName + '</td></tr>');
                    }
                }
            });
    }
    // Select All functionality
    document.getElementById('select-all').addEventListener('change', function () {
        const checkboxes = document.querySelectorAll('.select-user');
        checkboxes.forEach(checkbox => checkbox.checked = this.checked);
    });

    // Get all selected user IDs
    function getSelectedUserIds() {
        const selectedUsers = [];
        document.querySelectorAll('.select-user:checked').forEach(checkbox => {
            selectedUsers.push(checkbox.dataset.userId);
        });
        return selectedUsers;
    }
</script>