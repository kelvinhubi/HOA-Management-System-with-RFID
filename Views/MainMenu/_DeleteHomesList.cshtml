@model HomesList
@{
    Layout = "~/Views/Shared/_Layout1.cshtml";
    ViewData["Title"] = "Edit";
}
<form asp-action="_DeleteHomesList" class="form" id="thisform" style="bottom:29rem; display:block">
    <p class="title">Delete Home?</p>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="HomeID" hidden />
    <input asp-for="AccountID" hidden />
    <input asp-for="FullName" hidden />
    <input type="date" asp-for="CreatedAt" hidden />
    <div class="form-group">
        <label asp-for="HomeName" class="control-label"></label>
        <input asp-for="HomeName" class="form-control" class="House Type" />
        <span asp-validation-for="HomeName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="BlkNO" class="control-label">BlkNO</label>
        <input asp-for="BlkNO" class="form-control" />
        <span asp-validation-for="BlkNO" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="LotNo" class="control-label">LotNo</label>
        <input asp-for="LotNo" class="form-control" />
        <span asp-validation-for="LotNo" class="text-danger"></span>

    </div>
    <div class="form-group">
        <label asp-for="Address" class="control-label">Address</label>
        <input asp-for="Address" class="form-control" />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input type="submit" value="Save" class="btn btn-primary" />
    </div>
</form>

<a asp-controller="MainMenu" asp-action="VehicleManagement" class="btn btn-success" style="padding:5px; position:fixed">Back to List</a>
<script src="~/lib/jquery/dist/jquery.min.js"></script>