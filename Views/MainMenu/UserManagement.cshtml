@model NewModel
@{
    Layout = "~/Views/Shared/_Layout1.cshtml";
    
}
<head>
    <title>
        @{
            ViewData["Title"] = "User Management";
        }
    </title>
</head>
@Html.AntiForgeryToken();
<div id="UserPartial">
    <h2>Accounts</h2>
    <table id="mytable" class="table">
        <thead class="table-light">
            <tr>
                <th>Username</th>
                <th>Email</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var obj in Model.useracc)
            {
                <tr>
                    <td>@obj.Username</td>
                    <td>@obj.Email</td>
                    <td>
                        <a asp-action="_UserManagementDetails" class="btn  btn-success" style="padding:5px;" asp-route-id="@obj.AccountID" model="@Model">Details</a>
                        <a asp-action="_UserManagementDelete" class="btn btn-danger" style="padding:5px;" asp-route-id="@obj.AccountID">Delete</a>
                    </td>
                        
                </tr>
            }
        </tbody>
    </table>
</div>
@{
    User_Account user = new User_Account();
    <partial name="_UserManagementCreate" model="user" />
}
@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}
<script>
    new DataTable('#mytable');
</script>