@model Vehicle_Information
@{
    Layout = "~/Views/Shared/_Layout1.cshtml";
    ViewData["Title"] = "Edit";
}
<form asp-action="_EditVehicle" class="form" id="thisform" style="bottom:29rem; display:block">
    <p class="title">Edit Vehicle?</p>
    <input asp-for="VehicleID" hidden/>
    <input asp-for="AccountID" hidden />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="FullName" class="control-label"></label>
        <input asp-for="FullName" class="form-control" class="input" readonly />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="PlateNo" class="control-label"></label>
        <input asp-for="PlateNo" class="form-control" class="input"  />
        <span asp-validation-for="PlateNo" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="VehicleModel" class="control-label"></label>
        <input asp-for="VehicleModel" class="form-control" class="input"  />
        <span asp-validation-for="VehicleModel" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="VehicleType" class="control-label"></label>
        <input asp-for="VehicleType" class="form-control" class="input"  />
        <span asp-validation-for="VehicleType" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="RFID_number" class="control-label">RFID Number</label>
        <input asp-for="RFID_number" id="RFIDnumber" class="form-control input" readonly />
        <span asp-validation-for="RFID_number" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input type="submit" id="button1" value="Save" class="btn btn-primary" style="margin-top:10px;" />
    </div>
</form>
<a asp-controller="MainMenu" asp-action="VehicleManagement" class="btn btn-success" style="padding:5px; position:fixed">Back to List</a>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
     var ports;
    $("#RFIDnumber").on('click',async function () {
        //do dome scanning on rfid
        //client
        readport();
    });
   async function readport() { 
        if (ports == null) {
            console.log("port is null");
            ports = await requestport();
            console.log(ports);
            await ports.open({ baudRate: 921600 });
        }
       if (ports.connected) { 
            
            const textDecoder = new TextDecoder();
            const reader = port.readable.getReader();
            while (true) {
                const { value, done } = await reader.read();
                if (value) {
                    var text = textDecoder.decode(value)
                    $("#RFIDnumber").val(text.replace(/ /g, ""));
                }
                if (done) {
                    console.log('[readLoop] DONE', done);
                    reader.releaseLock();
                    break;
                }
            }
       }
        
    }
   async function requestport() { 
        port = await navigator.serial.requestPort();
       return port;
    }
</script>