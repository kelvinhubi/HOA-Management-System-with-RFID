@model NewModel
@{
    Layout = "~/Views/Shared/_Layout1.cshtml";

}
<head>
    <title>
        @{
            ViewData["Title"] = "Homes List";
        }
    </title>
</head>
<div id="UserPartial">
    <h2>Homes List</h2>
    <table id="mytable" class="table table-bordered" style="width:100%">
        <thead class="table-light">
            <tr>
                <th>Home ID</th>
                <th>Home Type</th>
                <th>Owner</th>
                <th>Blk No</th>
                <th>Lot No</th>
                <th>Address</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (HomesList obj in Model.Homes)
            {
                <tr>
                    <td>@obj.HomeID</td>
                    <td>@obj.HomeName</td>
                    <td>@obj.FullName</td>
                    <td>@obj.BlkNO</td>
                    <td>@obj.LotNo</td>
                    <td>@obj.Address</td>
                    <td>
                        <a asp-action="_EditHomesList" class="btn btn-success btn-sm" asp-route-id="@obj.HomeID" model="@Model.Homes">Edit<i class='bx bxs-edit-alt'></i></a>
                        <a asp-action="_DeleteHomesList" class="btn btn-danger btn-sm" asp-route-id="@obj.HomeID" model="@Model.Homes">Delete<i class='bx bxs-trash'></i></a>
                    </td>
                </tr>
            }

        </tbody>
    </table>
</div>
<div>
    <partial name="_AddHomesList" model="Model" />
</div>
@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
    new DataTable('#mytable');
</script>